def spec_keys(spec, allowed, required):
    if not isinstance(spec, dict):
        raise InputError("request must be a JSON object")
    extra = set(spec) - set(allowed) - set(required)
    if extra:
        raise InputError(f"unknown fields: {sorted(extra)}")
    missing = [k for k in required if k not in spec]
    if missing:
        raise InputError(f"missing fields: {missing}")


def spec_modes(spec):
    if "mode" in spec and spec["mode"] is not None:
        return [check_mode(spec["mode"])]
    return list(MODES)


def read_spec(stream):
    data = stream.read(MAX_SPEC_BYTES + 1)
    if len(data) > MAX_SPEC_BYTES:
        raise InputError("request too large")
    try:
        return json.loads(data or "{}")
    except ValueError as exc:
        raise InputError(f"request is not JSON: {exc}") from exc


def cmd_set(spec):
    spec_keys(spec, ("mode",), ("slug", "hosts"))
    slug = check_slug(spec["slug"])
    modes = spec_modes(spec)
    if not isinstance(spec["hosts"], list):
        raise InputError("hosts must be a list")
    policy = load_policy()
    hosts = sorted({normalize_host(h) for h in spec["hosts"]})
    if len(hosts) > policy["max_hosts"]:
        raise Refused(f"{len(hosts)} hosts exceed the admin limit of {policy['max_hosts']}")
    for host in hosts:
        if any(overlaps(d, host) for d in policy["deny"]):
            raise Refused(f"{host} is denied by the admin policy")
        if not any(covers(a, host) for a in policy["allow"]):
            raise Refused(f"{host} is outside the admin policy")
    app_dir = os.path.join(ETC_APPS, slug)
    if not os.path.isdir(app_dir):
        raise InputError(f"{slug} has no allocated instance")
    with flock():
        for mode in modes:
            path = egress_file(slug, mode)
            if hosts:
                write_atomic(path, json.dumps({"hosts": hosts}) + "\n", 0o600)
            else:
                with contextlib.suppress(FileNotFoundError):
                    os.unlink(path)
        compile_all(policy, load_nft=False)
    return {"slug": slug, "modes": modes, "hosts": hosts, "max_hosts": policy["max_hosts"],
            "enforced": enabled()}


def cmd_get(spec):
    spec_keys(spec, ("mode",), ("slug",))
    slug = check_slug(spec["slug"])
    return {"slug": slug, "egress": {m: read_hosts(slug, m) for m in spec_modes(spec)},
            "policy": public_policy(load_policy()), "enforced": enabled()}


def public_policy(policy):
    return {k: policy[k] for k in ("max_hosts", "allow", "deny", "ports", "build_hosts", "osv",
                                   "loopback_ports")}


def cmd_policy(spec):
    spec_keys(spec, (), ())
    return public_policy(load_policy())


def cmd_status(spec):
    spec_keys(spec, (), ())
    active = run([bin_path("systemctl"), "is-active", PROXY_UNIT]).stdout.strip()
    return {"enabled": enabled(), "table_loaded": table_loaded(), "proxy": active or "unknown",
            "instances": len(instances())}


def cmd_refresh():
    with flock():
        attached = compile_all(load_policy())
    return {"refreshed": True, "instances_with_rules": attached}


def cmd_attach(inst):
    slug, mode = split_instance(inst)
    if not read_env(os.path.join(ETC_APPS, slug, f"{mode}.env")).get("PORT", "").isdigit():
        raise HelperError(f"{inst} is not allocated")
    if not os.path.isdir(cgroup_dir(instance_cgroup(inst))):
        raise HelperError(f"no cgroup for {inst}: attach runs only as ExecStartPre=+ of its unit")
    with flock():
        attached = compile_all(load_policy())
    if inst not in attached:
        raise HelperError(f"egress rules for {inst} were not loaded")
    return {"attached": inst}


def cmd_attach_build(inst):
    split_instance(inst)
    if not os.path.isdir(cgroup_dir(build_cgroup(inst))):
        raise HelperError(f"no cgroup for the {inst} build: attach-build runs only as ExecStartPre=+")
    policy = load_policy()
    with flock():
        compile_all(policy)
    if not table_loaded():
        raise HelperError("the egress table is not loaded")
    gate = osv_gate(read_lockfile(staged_source(inst), policy["max_lock_bytes"]), policy)
    return {"attached_build": inst, "supply_chain": gate}


def build_env():
    return " ".join(f"{k}={v}" for k, v in proxy_env(BUILD_PROXY_PORT)) + \
        f" npm_config_proxy=http://{PROXY_HOST}:{BUILD_PROXY_PORT}" \
        f" npm_config_https_proxy=http://{PROXY_HOST}:{BUILD_PROXY_PORT}"


def cmd_enable():
    for template, text in (("aquarium-app@.service.d", APP_DROPIN.format(self=SELF_PATH, run=RUN_DIR)),
                           ("aquarium-app-build@.service.d",
                            BUILD_DROPIN.format(self=SELF_PATH, env=build_env()))):
        d = os.path.join(UNIT_DIR, template)
        os.makedirs(d, mode=0o755, exist_ok=True)
        write_atomic(os.path.join(d, DROPIN_NAME), text, 0o644)
    doc = cmd_refresh()
    run([bin_path("systemctl"), "daemon-reload"])
    proc = run([bin_path("systemctl"), "enable", "--now", PROXY_UNIT], timeout=90)
    if proc.returncode != 0:
        raise HelperError(f"could not start {PROXY_UNIT}: {proc.stderr.strip()[:200]}")
    return {"enabled": True, "restart_to_use_proxy": doc["instances_with_rules"]}


def cmd_disable():
    for template in ("aquarium-app@.service.d", "aquarium-app-build@.service.d"):
        with contextlib.suppress(FileNotFoundError):
            os.unlink(os.path.join(UNIT_DIR, template, DROPIN_NAME))
    run([bin_path("systemctl"), "disable", "--now", PROXY_UNIT], timeout=90)
    run([bin_path("nft"), "delete", "table", "inet", TABLE])
    run([bin_path("systemctl"), "daemon-reload"])
    return {"enabled": False}


# ---------------------------------------------------------------------------
# The allowlisting proxy (unprivileged; aquarium-app-egress-proxy.service)
# ---------------------------------------------------------------------------


def addr_ok(addr):
    """Only global unicast addresses: never loopback, private, link-local, CGNAT, metadata."""
    try:
        ip = ipaddress.ip_address(addr.split("%", 1)[0])
    except ValueError:
        return False
    if isinstance(ip, ipaddress.IPv6Address) and ip.ipv4_mapped:
        ip = ip.ipv4_mapped
    return ip.is_global and not ip.is_multicast


class Proxy:
    MAX_CONN_PER_PORT = 64
    CONNECT_TIMEOUT = 10
    IDLE_TIMEOUT = 15 * 60

    def __init__(self, allow_path, log=None):
        self.allow_path = allow_path
        self.allow = {"listeners": {}, "ports": [], "deny": list(BUILTIN_DENY), "allow": []}
        self.mtime = None
        self.servers = {}
        self.active = {}
        self.log = log or (lambda doc: print(json.dumps(doc), file=sys.stderr, flush=True))

    def load(self):
        try:
            mtime = os.stat(self.allow_path).st_mtime_ns
        except FileNotFoundError:
            mtime = None
        if mtime == self.mtime:
            return False
        self.mtime = mtime
        allow = {"listeners": {}, "ports": [], "deny": list(BUILTIN_DENY), "allow": []}
        if mtime is not None:
            with contextlib.suppress(OSError, ValueError):
                with open(self.allow_path, encoding="utf-8") as fh:
                    raw = json.load(fh)
                if isinstance(raw, dict):
                    allow.update({k: raw[k] for k in ("listeners", "ports", "allow") if k in raw})
                    allow["deny"] = sorted(set(BUILTIN_DENY) | set(raw.get("deny") or []))
        self.allow = allow
        return True

    def verdict(self, port, host, target_port):
        entry = self.allow["listeners"].get(str(port))
        if not entry:
            return "no egress for this listener"
        if target_port not in self.allow["ports"]:
            return f"port {target_port} is not allowed"
        policy = {"deny": self.allow["deny"], "allow": self.allow["allow"]}
        return host_verdict(host, entry.get("hosts") or [], policy)

    async def sync_listeners(self):
        wanted = {int(p) for p in self.allow["listeners"] if str(p).isdigit()}
        for port in set(self.servers) - wanted:
            self.servers.pop(port).close()
        for port in wanted - set(self.servers):
            try:
                self.servers[port] = await asyncio.start_server(
                    lambda r, w, p=port: self.handle(p, r, w), PROXY_HOST, port)
            except OSError as exc:
                self.log({"event": "listen_failed", "port": port, "error": str(exc)})

    async def resolve(self, host, port):
        loop = asyncio.get_running_loop()
        infos = await asyncio.wait_for(loop.getaddrinfo(host, port, type=1), self.CONNECT_TIMEOUT)
        return [info[4][0] for info in infos]

    async def handle(self, port, reader, writer):
        entry = self.allow["listeners"].get(str(port), {})
        inst = entry.get("inst", "?")
        if self.active.get(port, 0) >= self.MAX_CONN_PER_PORT:
            writer.close()
            return
        self.active[port] = self.active.get(port, 0) + 1
        host, target_port = "", 0
        try:
            head = await asyncio.wait_for(reader.readuntil(b"\r\n\r\n"), 10)
            if len(head) > MAX_HEAD_BYTES:
                raise ValueError("request head too large")
            parts = head.split(b"\r\n", 1)[0].decode("latin-1").split()
            if len(parts) != 3 or parts[0] != "CONNECT":
                await self.reply(writer, 405, "only HTTPS through CONNECT is allowed")
                return
            target = parts[1]
            host, _, port_s = target.rpartition(":")
            target_port = int(port_s) if port_s.isdigit() else 0
            try:
                host = normalize_host(host)
            except InputError:
                await self.deny(writer, inst, target, 0, "not a host name")
                return
            if host.startswith("*."):
                await self.deny(writer, inst, host, target_port, "not a host name")
                return
            reason = self.verdict(port, host, target_port)
            if reason:
                await self.deny(writer, inst, host, target_port, reason)
                return
            addrs = await self.resolve(host, target_port)
            if not addrs or not all(addr_ok(a) for a in addrs):
                await self.deny(writer, inst, host, target_port, "resolves to a non-public address")
                return
            up_r = up_w = None
            for addr in addrs:
                with contextlib.suppress(OSError, asyncio.TimeoutError):
                    up_r, up_w = await asyncio.wait_for(asyncio.open_connection(addr, target_port),
                                                        self.CONNECT_TIMEOUT)
                    break
            if up_w is None:
                await self.reply(writer, 502, "upstream unreachable")
                return
            self.log({"event": "connect", "inst": inst, "host": host, "port": target_port})
            writer.write(b"HTTP/1.1 200 Connection Established\r\n\r\n")
            await writer.drain()
            await asyncio.gather(self.pipe(reader, up_w), self.pipe(up_r, writer))
        except (asyncio.IncompleteReadError, asyncio.LimitOverrunError, asyncio.TimeoutError,
                ValueError, OSError, UnicodeError) as exc:
            self.log({"event": "error", "inst": inst, "host": host, "error": type(exc).__name__})
        finally:
            self.active[port] -= 1
            with contextlib.suppress(Exception):
                writer.close()

    async def pipe(self, src, dst):
        try:
            while True:
                data = await asyncio.wait_for(src.read(65536), self.IDLE_TIMEOUT)
                if not data:
                    break
                dst.write(data)
                await dst.drain()
        except (OSError, asyncio.TimeoutError):
            pass
        finally:
            with contextlib.suppress(Exception):
                dst.close()

    async def reply(self, writer, code, text):
        writer.write(f"HTTP/1.1 {code} {text}\r\nContent-Length: 0\r\nConnection: close\r\n\r\n".encode())
        with contextlib.suppress(OSError):
            await writer.drain()

    async def deny(self, writer, inst, host, port, reason):
        self.log({"event": "deny", "inst": inst, "host": host, "port": port, "reason": reason})
        await self.reply(writer, 403, f"egress refused: {reason}")

    async def serve(self, stop=None, poll=1.0):
        stop = stop or asyncio.Event()
        while not stop.is_set():
            if self.load():
                await self.sync_listeners()
            with contextlib.suppress(asyncio.TimeoutError):
                await asyncio.wait_for(stop.wait(), poll)
        for server in self.servers.values():
            server.close()


def cmd_proxy():
    if os.geteuid() == 0:
        raise HelperError("the proxy never runs as root (aquarium-app-egress-proxy.service)")
    proxy = Proxy(os.path.join(PROXY_VIEW, "allow.json"))

    async def main_loop():
        stop = asyncio.Event()
        loop = asyncio.get_running_loop()
        for sig in (signal.SIGTERM, signal.SIGINT):
            loop.add_signal_handler(sig, stop.set)
        await proxy.serve(stop)

    asyncio.run(main_loop())


