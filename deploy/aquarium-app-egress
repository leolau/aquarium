SUDO_VERBS = {"set": cmd_set, "get": cmd_get, "policy": cmd_policy, "status": cmd_status}
USAGE = ("usage: aquarium-app-egress " + "|".join(SUDO_VERBS) + " < request.json"
         " | enable | disable | refresh | attach <slug>-<mode> | attach-build <slug>-<mode> | proxy")


def main(argv=None, stdin=None):
    argv = list(sys.argv[1:] if argv is None else argv)
    out = sys.stderr if argv[:1] in (["attach"], ["attach-build"]) else sys.stdout
    try:
        if argv == ["proxy"]:
            cmd_proxy()
            return 0
        os.environ["PATH"] = SAFE_PATH
        os.umask(0o077)
        if os.geteuid() != 0:
            raise HelperError("aquarium-app-egress must run as root (use sudo -n)")
        if len(argv) == 1 and argv[0] in SUDO_VERBS:
            doc = SUDO_VERBS[argv[0]](read_spec(stdin or sys.stdin))
        elif argv == ["enable"]:
            doc = cmd_enable()
        elif argv == ["disable"]:
            doc = cmd_disable()
        elif argv == ["refresh"]:
            doc = cmd_refresh()
        elif len(argv) == 2 and argv[0] == "attach":
            doc = cmd_attach(argv[1])
        elif len(argv) == 2 and argv[0] == "attach-build":
            doc = cmd_attach_build(argv[1])
        else:
            raise InputError(USAGE)
    except InputError as exc:
        print(json.dumps({"error": str(exc), "bad_input": True}), file=out)
        return 2
    except Refused as exc:
        print(json.dumps({"error": str(exc), "refused": True}), file=out)
        return 3
    except (HelperError, OSError, tarfile.TarError, subprocess.SubprocessError) as exc:
        message = str(exc)
        if isinstance(exc, OSError):
            message = f"{exc.strerror or exc}" + (f": {exc.filename}" if exc.filename else "")
        print(json.dumps({"error": message[:300]}), file=out)
        return 1
    print(json.dumps(doc), file=out)
    return 0


if __name__ == "__main__":
    sys.exit(main())
