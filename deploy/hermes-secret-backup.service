# Daily encrypted backup of the credentials git does not hold
# (scripts/backup_secrets.py, docs/deployment/deployment-path.md).
#
# Runs as root because it must read every credential file, but root with no
# capabilities except read-anywhere, a read-only filesystem except the backup
# repo, and `python -I` from the root-owned checkout (F15): it can read
# secrets and write the encrypted bundle, nothing else.
[Unit]
Description=Hermes encrypted secret backup
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
EnvironmentFile=/opt/data/deploy/backup-recipient.env
ExecStart=/opt/data/hermes-agent/.venv/bin/python -I \
    /opt/data/hermes-agent/scripts/backup_secrets.py \
    --state-root /opt/data/hermes-deploy-state \
    --repo /opt/data/hermes-deploy-backups \
    backup --deployment hermes-systest --push
CapabilityBoundingSet=CAP_DAC_READ_SEARCH
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=read-only
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes
ReadWritePaths=/opt/data/hermes-deploy-backups
