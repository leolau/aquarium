# Agent terminal commands run as hermes-tools (never root); see deploy/hermes-tools-exec.
# SETENV keeps the gateway's already-filtered terminal environment (sudo -E);
# !secure_path keeps its PATH (venv, node, user tools); !use_pty keeps the
# command in the caller's process group so timeouts and kills still reach it.
Defaults!/usr/local/sbin/hermes-tools-exec !use_pty, !secure_path
hermes ALL=(hermes-tools) NOPASSWD:SETENV: /usr/local/sbin/hermes-tools-exec
# The agent's `hermes ...` calls (deploy/hermes-tools-shim) go back to hermes through
# deploy/hermes-tools-cli, which runs only an allowlist. No SETENV: sudo resets the
# environment, keeping just the kanban worker variables and the requester ticket
# (FG-33 0.4), all of which the helper checks.
Defaults!/usr/local/sbin/hermes-tools-cli !use_pty, env_keep += "HERMES_KANBAN_TASK HERMES_KANBAN_RUN_ID HERMES_PRINCIPAL_TICKET"
hermes-tools ALL=(hermes) NOPASSWD: /usr/local/sbin/hermes-tools-cli
