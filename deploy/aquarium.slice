# FG-33 parent slice: one hard memory ceiling for everything local apps use.
# systemd nests slices by name, so aquarium-apps.slice (running apps),
# aquarium-build.slice (the one shared build/live-edit slot) and
# aquarium-db.slice (the apps compose project) are its children:
# 3 GB + 2 GB + 1 GB = 6 GB, leaving >= 3 GB of the box for the gateway,
# FG-31 sessions, hermes-embed and the shared Supabase stack.
# Installed by aq_install_app_runtime (deploy/install/lib.sh). Core.
[Unit]
Description=Aquarium local apps (FG-33 parent slice, 6 GB ceiling)
Documentation=docs/design/master-plan/feature-groups/FG-33-vibe-coded-apps-local-and-external.md

[Slice]
MemoryAccounting=yes
CPUAccounting=yes
TasksAccounting=yes
MemoryHigh=5632M
MemoryMax=6G
MemorySwapMax=0
