# Versions install-aquarium.sh installs. Bump deliberately: each value is checked at install
# time (sha256 / exact apt version / exact git commit), so a changed upstream cannot slip in.
# Sourced by install-aquarium.sh; plain KEY=value lines only.

# Cosign verifies the Aquarium release signature (keyless, GitHub Actions OIDC).
COSIGN_VERSION=v2.6.5
COSIGN_SHA256=c3b4f5410e608af03a5eb0aaac84a4313d8da131248e08ff1759ac70c79d1644
# The release workflow file in leolau/aquarium whose tag runs sign SHA256SUMS.
AQUARIUM_RELEASE_WORKFLOW=release.yml

# uv (Python venvs): release tarball for x86_64 Linux.
UV_VERSION=0.13.1
UV_SHA256=eadd9d27c134ab5ac1ffd4473b97a741407f3ea238288f03121fc4deddf90220

# Debian package versions from the NodeSource and Caddy apt repositories.
NODE_DEB_VERSION=22.23.3-1nodesource1
CADDY_DEB_VERSION=2.11.7

# supabase/supabase commit whose docker/ folder is the Compose stack; its images are
# pinned by digest in supabase-images.lock (regenerate both together).
SUPABASE_COMMIT=7425d4930528931400fb3e656e860b1094cb224e
