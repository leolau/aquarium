#!/usr/bin/python3 -I
"""hermes-tools-cli: run one allowlisted ``hermes`` command as hermes for the agent.

With ``terminal.run_as: hermes-tools`` the agent's commands run as hermes-tools,
which cannot read ``$HERMES_HOME/.env``, so the ``hermes`` CLI cannot start
there. Skills still call ``hermes kanban …``, ``hermes tool new …``,
``hermes promote …``. Inside the agent's shell, ``hermes`` is the shim
/usr/local/lib/hermes-tools/bin/hermes (deploy/hermes-tools-shim), which runs

    sudo -n -u hermes /usr/local/sbin/hermes-tools-cli <args>

sudo resets the environment (the rule has no SETENV). This script runs as
hermes, refuses anything that is not on COMMANDS below, rebuilds the
environment from root-owned settings, and execs the real ``hermes``. It never
takes a profile, a HERMES_HOME, a config path or a Python setting from the
caller. Install only a root-owned copy:

    install -m 0755 -o root -g root deploy/hermes-tools-cli /usr/local/sbin/hermes-tools-cli

Settings, root-owned (written by deploy/hermes-tools-setup):

    /etc/hermes-tools/cli.conf
        HERMES_HOME=/path/to/hermes-home
        HERMES_BIN=/path/to/checkout/.venv/bin/hermes
        ENV_FILE=/path/to/the/gateway/EnvironmentFile   (repeatable)
"""

import base64
import hashlib
import hmac
import os
import pwd
import re
import stat
import sys
import time

CONF = "/etc/hermes-tools/cli.conf"
RUN_USER = "hermes"
CALLER = "hermes-tools"
#: Kanban workers say which task they are; passed by sudo's env_keep, checked here.
#: HERMES_PROFILE rides along so a card's ``projects outputs deliver`` can
#: attribute the delivery to the worker profile that produced it.
KEEP_ENV = {
    "HERMES_KANBAN_TASK": re.compile(r"[A-Za-z0-9_.:-]{1,128}"),
    "HERMES_KANBAN_RUN_ID": re.compile(r"[0-9]{1,18}"),
    "HERMES_PROFILE": re.compile(r"[A-Za-z0-9_-]{1,64}"),
}
#: The requester ticket the gateway mints per chat turn (hermes_cli/principal_ticket.py).
#: Verified here with the key only hermes can read, and turned into
#: ``hermes tool --as=<user>`` (``hermes tool`` refuses to run without it) or
#: ``hermes projects --actor=<user>`` (refused here without it: that CLI would
#: otherwise act as the owner).
TICKET_ENV = "HERMES_PRINCIPAL_TICKET"
TICKET_KEY = "auth/principal-ticket.key"
#: The chat a ``projects create --from-chat`` runs in (gateway session var),
#: kept only for that command; the CLI finds the profile holding it and requires
#: its owner to be the ticket's person, and that profile hosts the project.
SESSION_ENV = {"HERMES_SESSION_ID": re.compile(r"[A-Za-z0-9_.:-]{1,128}")}
TICKET_RE = re.compile(r"v1\.([A-Za-z0-9_-]{1,1024})\.([0-9]{1,16})\.([A-Za-z0-9_-]{43})")
MAX_ARGS = 256
MAX_ARG_LEN = 256 * 1024

V = True   # option takes a value
F = False  # flag
#: An option whose value must be one of a fixed set (enum flags, never paths).
MODES = frozenset({"dev", "prod"})
TEMPLATES = frozenset({"minimal", "nextjs-supabase"})
HOSTINGS = frozenset({"local", "external"})
PROVIDERS = frozenset({"vercel", "railway", "aws_amplify", "alibaba_fc"})
_APP = {"--mode": MODES}

_KANBAN_LIST = {"--mine": F, "--assignee": V, "--status": V, "--tenant": V,
                "--session": V, "--archived": F, "--json": F, "--sort": V,
                "--workflow-template-id": V, "--step-key": V}
_CRON_JOB = {"--name": V, "--deliver": V, "--repeat": V, "--skill": V,
             "--script": V, "--no-agent": F, "--workdir": V}
_VPN = {"--json": F}
#: Text read from stdin only: the shim turns a file the agent names into stdin.
STDIN = frozenset({"-"})
CADENCES = frozenset({"one_off", "repeatable", "standing"})
_NUM = re.compile(r"[0-9]{1,9}")
#: A project slug/ref or step key: one URL path segment, never ``..`` or ``/``.
_NAME = re.compile(r"[A-Za-z0-9][A-Za-z0-9_-]{0,127}")
ARGS = "args"  # a leaf's check of its positional arguments


def _one(what):
    def check_args(pos):
        if len(pos) != 1:
            raise Refused(f"needs exactly one {what}")
    return check_args


def _json_arg(value):
    if value != "-" and not value.lstrip().startswith("{"):
        raise Refused("give the JSON inline ({...}) or '-' for stdin, never a path")


#: ``playbook <slug> [show [rev] | save - | draft <verb> ...]``. ``save`` (propose a
#: revision) reads stdin; ``activate`` is a person's act and stays off.
#: Phase 8 co-create: the agent edits only the chatting person's working draft.
#: A new ``draft`` verb the projects skill needs goes in PLAYBOOK_DRAFT.
PLAYBOOK_DRAFT = {
    "show": 0,
    "discard": 0,
    "set": 1,         # <json>
    "patch-step": 2,  # <key> <json>
}


def _playbook_args(pos):
    if not pos:
        raise Refused("`hermes projects playbook` needs a project")
    if not _NAME.fullmatch(pos[0]):
        raise Refused("the project must be its slug or ref")
    action, rest = (pos[1], pos[2:]) if len(pos) > 1 else ("show", [])
    if action == "show":
        if len(rest) > 1 or (rest and not _NUM.fullmatch(rest[0])):
            raise Refused("playbook show takes at most a revision number")
    elif action == "save":
        if rest != ["-"]:
            raise Refused("playbook save reads the spec from stdin ('-')")
    elif action == "draft":
        verb, extra = (rest[0], rest[1:]) if rest else ("show", [])
        if verb not in PLAYBOOK_DRAFT:
            raise Refused(f"`playbook draft {verb}` is not available")
        if len(extra) != PLAYBOOK_DRAFT[verb]:
            raise Refused(f"playbook draft {verb} takes {PLAYBOOK_DRAFT[verb]} argument(s)")
        if extra:
            _json_arg(extra[-1])
        if verb == "patch-step" and ("/" in extra[0] or extra[0] in (".", "..")):
            raise Refused("the step key must be one name")
    else:
        raise Refused(f"`hermes projects playbook {action}` is not available")


#: ``outputs <slug> [list | add <title> | deliver <output id>]`` — a run's
#: deliver card files its workbook this way (FG-32: ``add`` is agent-proposable,
#: ``accept`` stays a human's act and is refused here).
def _outputs_args(pos):
    if not pos or not _NAME.fullmatch(pos[0]):
        raise Refused("`hermes projects outputs` needs the project slug")
    action, rest = (pos[1], pos[2:]) if len(pos) > 1 else ("list", [])
    if action not in ("list", "add", "deliver"):
        raise Refused(f"`hermes projects outputs {action}` is not available")
    if action == "list":
        if rest:
            raise Refused("outputs list takes no argument")
    elif len(rest) != 1:
        raise Refused(f"outputs {action} takes one argument")
    elif action == "deliver" and not _NAME.fullmatch(rest[0]):
        raise Refused("the output must be its id (o_…)")


#: command -> {"opts": options at this level, "subs": subcommands} or leaf options.
#: Anything not listed, at any level, is refused: hermes config/auth/dashboard/
#: gateway/setup/..., cron tick and --accept-hooks, tool --as and new --root, tool config
#: --file (the shim reads that file as hermes-tools and passes --json), skills
#: install --force (keeps the skills security scan), owner init/alias. The FG-33
#: lifecycle verbs `tool archive|restore|purge` and `tool set --coder-profile` stay
#: off on purpose: they are a person's act (Tools page or own shell), never the agent's.
COMMANDS = {
    "promote": {"--actor": V, "--approve": F},
    "owner": {"subs": {
        "show": {},
        "transfer": {"--actor": V, "--approve": F, "--demote-to": V},
    }},
    "tool": {"opts": {"--mode": MODES}, "subs": {
        "new": {"--shared": F, "--template": TEMPLATES, "--hosting": HOSTINGS,
                "--provider": PROVIDERS},
        "list": {},
        "enable": {},
        "disable": {},
        "config": {"--json": V},
        "promote": {},
        # FG-33 local apps; prod instances only move through the API's checks.
        "build": _APP,
        "start": _APP,
        "stop": _APP,
        "restart": _APP,
        "logs": {**_APP, "--lines": re.compile(r"[0-9]{1,4}")},
        "status": _APP,
        "preview": _APP,
        "doctor": {"--json": F},
    }},
    "cron": {"subs": {
        "list": {"--all": F},
        "status": {},
        "create": _CRON_JOB,
        "add": _CRON_JOB,
        "edit": {**_CRON_JOB, "--schedule": V, "--prompt": V, "--add-skill": V,
                 "--remove-skill": V, "--clear-skills": F, "--agent": F},
        "pause": {},
        "resume": {},
        "run": {},
        "remove": {},
        "rm": {},
        "delete": {},
    }},
    "kanban": {"opts": {"--board": V}, "subs": {
        "list": _KANBAN_LIST,
        "ls": _KANBAN_LIST,
        "show": {"--json": F, "--state-type": V, "--state-name": V},
        "create": {"--body": V, "--assignee": V, "--parent": V, "--workspace": V,
                   "--branch": V, "--project": V, "--tenant": V, "--priority": V,
                   "--triage": F, "--idempotency-key": V, "--max-runtime": V,
                   "--created-by": V, "--skill": V, "--max-retries": V, "--goal": F,
                   "--goal-max-turns": V, "--initial-status": V, "--json": F},
        "tail": {"--interval": V},
        "watch": {"--assignee": V, "--tenant": V, "--kinds": V, "--interval": V},
        "stats": {"--json": F},
        "block": {"--ids": V, "--kind": V},
        "unblock": {"--reason": V},
        "archive": {"--rm": V},
        "comment": {"--author": V, "--max-len": V},
        "complete": {"--result": V, "--summary": V, "--metadata": V},
    }},
    "vpn": {"subs": {"list": _VPN, "status": _VPN, "up": _VPN, "down": _VPN}},
    "skills": {"subs": {
        "search": {"--source": V, "--limit": V, "--json": F},
        "install": {"--category": V, "--name": V, "--yes": F},
        "list": {"--source": V, "--enabled-only": F},
        "inspect": {},
    }},
    "memory": {"subs": {"status": {}}},
    # Start a project from chat and propose its playbook, as the chatting person
    # (ticket -> --actor; an --actor given must be that person). The host is the
    # chat's profile. Off: --as-human, --host-profile, delete/archive/restore,
    # activate, run, members. ``outputs`` is the exception to the ticket rule:
    # a kanban worker carrying HERMES_KANBAN_TASK files its card's delivery as
    # the box owner (the env marker is an intent check, not a boundary — every
    # caller here already runs inside the same hermes-tools shell).
    "projects": {"opts": {"--actor": V}, "subs": {
        "create": {ARGS: _one("goal sentence"), "--description": STDIN, "--output": V,
                   "--name": V, "--cadence": CADENCES, "--audience": V, "--goal-id": V,
                   "--from-chat": re.compile(r"[1-5]"), "--chat-summary": V, "--json": F},
        "playbook": {ARGS: _playbook_args, "--note": V, "--after": V,
                     "--expected-version": _NUM, "--from-rev": _NUM, "--json": F},
        "outputs": {ARGS: _outputs_args, "--spec": V, "--optional": F,
                    "--recurring": F, "--ref": V, "--note": V, "--task": V,
                    "--run": V, "--json": F},
    }},
}
HELP = {"-h": F, "--help": F}


class Refused(Exception):
    pass


def _check_value(name, spec, value):
    if isinstance(spec, frozenset) and value not in spec:
        raise Refused(f"{name} must be one of {', '.join(sorted(spec))}")
    if isinstance(spec, re.Pattern) and not spec.fullmatch(value):
        raise Refused(f"{name} has an invalid value")


def _option(argv, i, opts):
    name, eq, value = argv[i].partition("=")
    if name not in opts:
        raise Refused(f"option {name!r} is not allowed here")
    spec = opts[name]
    if eq:
        if spec is F:
            raise Refused(f"{name} takes no value")
        _check_value(name, spec, value)
        return i + 1
    if spec is not F:
        if i + 1 >= len(argv) or (argv[i + 1].startswith("-") and argv[i + 1] != "-"):
            raise Refused(f"{name} needs a value (write {name}=VALUE if it starts with '-')")
        _check_value(name, spec, argv[i + 1])
        return i + 2
    return i + 1


def check(argv):
    """Return the command path (e.g. ``['tool', 'new']``) or raise Refused."""
    if not argv:
        raise Refused("no command given")
    if len(argv) > MAX_ARGS:
        raise Refused("too many arguments")
    for arg in argv:
        if "\x00" in arg or len(arg) > MAX_ARG_LEN:
            raise Refused("argument too long or not text")
    node, path, i = {"subs": COMMANDS}, [], 0
    while "subs" in node:
        if i >= len(argv):
            raise Refused(f"`hermes {' '.join(path)}` needs a subcommand")
        tok = argv[i]
        if tok.startswith("-"):
            if not path and tok not in HELP:
                raise Refused(f"option {tok.partition('=')[0]!r} is not allowed here")
            i = _option(argv, i, {**HELP, **node.get("opts", {})})
            continue
        if tok not in node["subs"]:
            raise Refused(f"`hermes {' '.join(path + [tok])}` is not available")
        path.append(tok)
        node = node["subs"][tok]
        i += 1
    opts = {**HELP, **{k: v for k, v in node.items() if k != ARGS}}
    positional, helped = [], False
    while i < len(argv):
        if argv[i].startswith("-") and argv[i] != "-":
            helped = helped or argv[i] in HELP
            i = _option(argv, i, opts)
        else:
            positional.append(argv[i])
            i += 1
    if ARGS in node and not helped:
        node[ARGS](positional)
    return path


def _trusted(path, uids, bad_gids, follow_final=True):
    """Every directory up to *path*, and the file, safe from the caller."""
    real = os.path.realpath(path)
    for target in {path, real}:
        current = "/"
        parts = [p for p in target.split("/") if p]
        for n, part in enumerate([None] + parts):
            if part is not None:
                current = os.path.join(current, part)
            st = os.lstat(current)
            if st.st_uid not in uids:
                raise Refused(f"{current} is not owned by root or {RUN_USER}")
            if stat.S_ISLNK(st.st_mode):
                continue
            if st.st_mode & stat.S_IWOTH and not (stat.S_ISDIR(st.st_mode) and st.st_mode & stat.S_ISVTX):
                raise Refused(f"{current} is writable by everyone")
            if st.st_mode & stat.S_IWGRP and st.st_gid in bad_gids:
                raise Refused(f"{current} is writable by {CALLER}")
    return real


def _read_conf(bad_gids):
    _trusted(CONF, {0}, bad_gids)
    conf = {"ENV_FILE": []}
    with open(CONF, encoding="utf-8") as fh:
        for line in fh:
            line = line.strip()
            if not line or line.startswith("#") or "=" not in line:
                continue
            key, value = (s.strip() for s in line.split("=", 1))
            if key == "ENV_FILE":
                conf["ENV_FILE"].append(value)
            elif key in ("HERMES_HOME", "HERMES_BIN"):
                conf[key] = value
    for key in ("HERMES_HOME", "HERMES_BIN"):
        if not os.path.isabs(conf.get(key, "")):
            raise Refused(f"{CONF} must set {key} to an absolute path")
    return conf


def _env_file(path):
    values = {}
    with open(path, encoding="utf-8") as fh:
        for line in fh:
            line = line.strip()
            if line.startswith("export "):
                line = line[7:].lstrip()
            if not line or line.startswith("#") or "=" not in line:
                continue
            key, value = line.split("=", 1)
            key, value = key.strip(), value.strip()
            if len(value) >= 2 and value[0] == value[-1] and value[0] in "\"'":
                value = value[1:-1]
            if re.fullmatch(r"[A-Za-z_][A-Za-z0-9_]*", key):
                values[key] = value
    return values


def verify_ticket(ticket, key, now_ms=None):
    """Stdlib copy of ``hermes_cli.principal_ticket.verify``: user id or None."""
    match = TICKET_RE.fullmatch(ticket or "")
    if not match or not key:
        return None
    uid_raw, expires_raw, sig = match.groups()
    payload = f"v1.{uid_raw}.{expires_raw}".encode("ascii")
    expected = base64.urlsafe_b64encode(hmac.new(key, payload, hashlib.sha256).digest()).rstrip(b"=")
    if not hmac.compare_digest(expected.decode("ascii"), sig):
        return None
    if (now_ms if now_ms is not None else time.time() * 1000) > int(expires_raw):
        return None
    try:
        user_id = base64.urlsafe_b64decode(uid_raw + "=" * (-len(uid_raw) % 4)).decode("utf-8")
    except (ValueError, UnicodeDecodeError):
        return None
    return user_id if user_id.strip() and "\x00" not in user_id else None


def _ticket_key(home, uids, bad_gids):
    path = os.path.join(home, TICKET_KEY)
    _trusted(path, uids, bad_gids)
    st = os.stat(path)
    if not stat.S_ISREG(st.st_mode) or st.st_mode & 0o077:
        raise Refused(f"{path} must be a 0600 file")
    with open(path, "rb") as fh:
        return fh.read().strip()


#: Commands that act as the chatting person, and the option that names them.
AS_REQUESTER = {"tool": "--as", "projects": "--actor"}


def as_requester(path, argv, ticket, key, now_ms=None, worker=False):
    """``(argv, ticket)`` for the real CLI: a verified ticket becomes
    ``tool --as=<user>`` or ``projects --actor=<user>``.

    Anything else passes no ticket on. For ``hermes tool`` a ticket that does not
    verify passes nothing on and the CLI refuses (fails closed); ``hermes projects``
    would act as the owner without one, so it is refused here — except
    ``projects outputs`` from a card worker (``worker``: the caller carried a
    valid ``HERMES_KANBAN_TASK``), which files its card's delivery as the box
    owner. A worker can never pass ``--actor``: it is not a person.
    """
    if not path or path[0] not in AS_REQUESTER:
        return argv, ""
    user_id = verify_ticket(ticket, key, now_ms)
    if user_id is None:
        if path[0] == "projects":
            if worker and path[:2] == ["projects", "outputs"]:
                _rest, named = _without_option(argv[1:], "--actor")
                if named:
                    raise Refused("`projects outputs` from a card runs as the "
                                  "box owner — never as --actor")
                return argv, ""
            raise Refused("`hermes projects` runs only for the person in this chat "
                          "(no valid requester ticket)")
        return argv, ""
    rest = argv[1:]
    if path[0] == "projects":
        rest, named = _without_option(rest, "--actor")
        if any(n != user_id for n in named):
            raise Refused("--actor can only be the person in this chat")
    return [argv[0], f"{AS_REQUESTER[path[0]]}={user_id}", *rest], ticket


def _without_option(argv, name):
    """``(argv without NAME and its values, the values)``."""
    out, values, i = [], [], 0
    while i < len(argv):
        if argv[i] == name and i + 1 < len(argv):
            values.append(argv[i + 1])
            i += 2
        elif argv[i].startswith(name + "="):
            values.append(argv[i].partition("=")[2])
            i += 1
        else:
            out.append(argv[i])
            i += 1
    return out, values


def session_args(path, environ):
    """The chat env a ``projects create`` runs in (checked), else nothing."""
    if path != ["projects", "create"]:
        return {}
    return {k: environ[k] for k, pattern in SESSION_ENV.items()
            if environ.get(k) and pattern.fullmatch(environ[k])}


def main(argv):
    me = pwd.getpwuid(os.geteuid())
    if me.pw_name != RUN_USER or os.getuid() != os.geteuid():
        print(f"hermes-tools-cli: must run as {RUN_USER} (sudo -u {RUN_USER})", file=sys.stderr)
        return 2
    try:
        caller = pwd.getpwnam(CALLER)
        bad_gids = set(os.getgrouplist(CALLER, caller.pw_gid))
    except KeyError:
        bad_gids = set()
    bad_gids.discard(0)
    try:
        path = check(argv)
        conf = _read_conf(bad_gids)
        hermes_bin = _trusted(conf["HERMES_BIN"], {0, me.pw_uid}, bad_gids)
        _trusted(conf["HERMES_HOME"], {0, me.pw_uid}, bad_gids)
    except Refused as exc:
        print(f"hermes: refused: {exc}. From the agent's terminal only these work: "
              + ", ".join(f"hermes {c}" for c in COMMANDS), file=sys.stderr)
        return 2
    except OSError as exc:
        print(f"hermes-tools-cli: {exc}", file=sys.stderr)
        return 2

    env = {}
    for env_file in conf["ENV_FILE"]:
        try:
            env.update(_env_file(env_file))
        except OSError as exc:
            print(f"hermes-tools-cli: cannot read {env_file} as {RUN_USER}: {exc}", file=sys.stderr)
            return 2
    for key in [k for k in env if k.startswith(("PYTHON", "LD_", "HERMES_PROFILE"))]:
        del env[key]
    for key, pattern in KEEP_ENV.items():
        value = os.environ.get(key, "")
        if value and pattern.fullmatch(value):
            env[key] = value
    for key in (TICKET_ENV, *SESSION_ENV):
        env.pop(key, None)
    ticket = os.environ.get(TICKET_ENV, "")
    worker = bool(env.get("HERMES_KANBAN_TASK"))
    if path[0] in AS_REQUESTER and (ticket or path[0] == "projects"):
        try:
            ticket_key = _ticket_key(conf["HERMES_HOME"], {0, me.pw_uid}, bad_gids)
        except (Refused, OSError):
            ticket_key = b""
        try:
            argv, ticket = as_requester(path, argv, ticket, ticket_key, worker=worker)
        except Refused as exc:
            print(f"hermes: refused: {exc}.", file=sys.stderr)
            return 2
        if ticket:
            env[TICKET_ENV] = ticket
    env.update(session_args(path, os.environ))
    env.update({
        "HERMES_HOME": conf["HERMES_HOME"],
        "HOME": me.pw_dir,
        "USER": RUN_USER,
        "LOGNAME": RUN_USER,
        "PATH": os.path.dirname(hermes_bin) + ":/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin",
        "LANG": "C.UTF-8",
        "HERMES_TOOLS_CLI": " ".join(path),
    })
    os.umask(0o007)
    os.chdir(conf["HERMES_HOME"])
    os.execve(hermes_bin, [hermes_bin, *argv], env)
    return 127


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
