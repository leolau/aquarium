def read_log(slug):
    try:
        with open(paths(slug)["log"], encoding="utf-8", errors="replace") as fh:
            return fh.read()[-65536:]
    except OSError:
        return ""


def parse_log(text):
    out = {"up": "Tunnel is up and running." in text, "iface": None, "local_ip": None,
           "dns": [], "suffix": None}
    m = re.search(r"Interface (ppp[0-9]{1,4}) is UP\.", text)
    if m:
        out["iface"] = m.group(1)
    m = re.search(r"Got addresses: \[([0-9.]+)\], ns \[([0-9., ]*)\](?:, ns_suffix \[([A-Za-z0-9.-]*)\])?", text)
    if m:
        out["local_ip"] = m.group(1)
        out["dns"] = [d.strip() for d in m.group(2).split(",") if d.strip() not in ("", "0.0.0.0")]
        out["suffix"] = m.group(3) or None
    return out


def classify_log(text, host, port):
    """(state, message, cert_sha256) for a failed openfortivpn run."""
    m = re.search(r"trusted-cert = ([0-9a-f]{64})", text)
    if "not in the local whitelist" in text or m:
        return "needs_cert", "The VPN server's certificate is not trusted yet", (m.group(1) if m else None)
    if "Could not authenticate to gateway" in text:
        return "error", "Login failed: wrong username or password", None
    if "Please make sure tunnel mode is allowed" in text:
        return "error", "Login refused: tunnel mode is not allowed for this account (check the realm)", None
    if re.search(r"one-time password|No OTP specified|No token specified|FortiToken", text):
        return "error", "This VPN asks for a one-time code (FortiToken), which is not supported yet", None
    m = re.search(r"getaddrinfo: (.+)", text)
    if m:
        return "error", f"Can't find the VPN server {host}", None
    m = re.search(r"connect: (.+)", text)
    if m:
        return "error", f"Can't reach the VPN server {host}:{port} ({m.group(1).strip()[:80]})", None
    if "SSL_connect" in text:
        return "error", f"Secure connection to {host}:{port} failed", None
    if "Timed out waiting for the ppp interface" in text:
        return "error", "The VPN tunnel did not come up (ppp timeout)", None
    errors = [ln.split(":", 1)[1].strip() for ln in text.splitlines() if ln.startswith("ERROR:")]
    if errors:
        return "error", f"VPN client failed: {errors[-1][:160]}", None
    return "error", "VPN client exited unexpectedly", None


