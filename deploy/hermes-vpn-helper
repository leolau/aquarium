def render_openfortivpn_config(spec):
    """Allowlisted keys only; routing and DNS are always ours, never pppd's."""
    lines = [
        f"host = {spec['host']}",
        f"port = {spec['port']}",
        f"username = {spec['username']}",
        f"password = {spec['password']}",
    ]
    if spec.get("realm"):
        lines.append(f"realm = {spec['realm']}")
    if spec.get("trusted_cert"):
        lines.append(f"trusted-cert = {spec['trusted_cert']}")
    lines += [
        "set-routes = 0",
        "set-dns = 0",
        "pppd-use-peerdns = 0",
        "half-internet-routes = 0",
    ]
    for line in lines:
        if CONTROL_RE.search(line):
            raise InputError("config value contains control characters")
    return "\n".join(lines) + "\n"


def render_smb_credentials(spec):
    lines = [
        f"username={spec.get('share_username') or spec['username']}",
        f"password={spec.get('share_password') or spec['password']}",
    ]
    if spec.get("share_domain"):
        lines.append(f"domain={spec['share_domain']}")
    for line in lines:
        if CONTROL_RE.search(line):
            raise InputError("share credential contains control characters")
    return "\n".join(lines) + "\n"


def render_folder_credentials(spec):
    lines = [f"username={spec['share_username']}", f"password={spec['share_password'] or ''}"]
    if spec.get("share_domain"):
        lines.append(f"domain={spec['share_domain']}")
    for line in lines:
        if CONTROL_RE.search(line):
            raise InputError("share credential contains control characters")
    return "\n".join(lines) + "\n"


def write_private(path, text):
    with contextlib.suppress(FileNotFoundError):
        os.unlink(path)
    fd = os.open(path, os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW, 0o600)
    with os.fdopen(fd, "w") as fh:
        fh.write(text)


def remove(path):
    with contextlib.suppress(FileNotFoundError):
        os.unlink(path)


# ---------------------------------------------------------------------------
# Paths, state, locking
# ---------------------------------------------------------------------------


def slug_dir(slug):
    os.makedirs(RUN_DIR, mode=0o700, exist_ok=True)
    os.chmod(RUN_DIR, 0o700)
    path = os.path.join(RUN_DIR, slug)
    os.makedirs(path, mode=0o700, exist_ok=True)
    return path


def paths(slug):
    base = os.path.join(RUN_DIR, slug)
    return {
        "dir": base,
        "state": os.path.join(base, "state.json"),
        "conf": os.path.join(base, "openfortivpn.conf"),
        "creds": os.path.join(base, "smb.cred"),
        "log": os.path.join(base, "openfortivpn.log"),
        "lock": os.path.join(base, "lock"),
        "mount": os.path.join(MOUNT_ROOT, slug),
        "unit": f"hermes-vpn-{slug}.service",
        "timer": f"hermes-vpn-idle-{slug}",
    }


def folder_paths(folder_slug):
    name = folder_name(folder_slug)
    return {"name": name, "mount": os.path.join(MOUNT_ROOT, name)}


def load_state(slug):
    try:
        with open(paths(slug)["state"], encoding="utf-8") as fh:
            doc = json.load(fh)
        return doc if isinstance(doc, dict) else {}
    except (OSError, ValueError):
        return {}


def save_state(slug, doc):
    slug_dir(slug)
    target = paths(slug)["state"]
    fd, tmp = tempfile.mkstemp(dir=os.path.dirname(target), prefix=".state-")
    with os.fdopen(fd, "w") as fh:
        json.dump(doc, fh)
    os.replace(tmp, target)


@contextlib.contextmanager
def slug_lock(slug, *, blocking=True):
    slug_dir(slug)
    fd = os.open(paths(slug)["lock"], os.O_RDWR | os.O_CREAT | os.O_NOFOLLOW, 0o600)
    try:
        try:
            fcntl.flock(fd, fcntl.LOCK_EX | (0 if blocking else fcntl.LOCK_NB))
        except BlockingIOError:
            yield False
            return
        yield True
    finally:
        os.close(fd)


def lock_busy(slug):
    path = paths(slug)["lock"]
    if not os.path.exists(path):
        return False
    fd = os.open(path, os.O_RDWR | os.O_NOFOLLOW)
    try:
        fcntl.flock(fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
        return False
    except BlockingIOError:
        return True
    finally:
        os.close(fd)


def secure_mount_point(slug):
    """Create MOUNT_ROOT/<slug> under a chain no non-root user can rewrite."""
    root = os.path.abspath(MOUNT_ROOT)
    parent = os.path.dirname(root)
    current = "/"
    for part in [p for p in parent.split("/") if p] + [None]:
        st = os.lstat(current)
        if stat.S_ISLNK(st.st_mode) or not stat.S_ISDIR(st.st_mode):
            raise HelperError(f"{current} must be a real directory")
        if st.st_uid not in TRUSTED_UIDS:
            raise HelperError(f"{current} must be owned by root to host VPN mounts")
        if st.st_mode & 0o022 and not st.st_mode & stat.S_ISVTX:
            raise HelperError(f"{current} must not be group/world writable")
        if part is None:
            break
        current = os.path.join(current, part)
    for path in (root, os.path.join(root, slug)):
        if not os.path.lexists(path):
            os.mkdir(path, 0o755)
        st = os.lstat(path)
        if stat.S_ISLNK(st.st_mode) or not stat.S_ISDIR(st.st_mode):
            raise HelperError(f"{path} must be a real directory")
        if st.st_uid not in TRUSTED_UIDS or st.st_mode & 0o022:
            raise HelperError(f"{path} must be root-owned and not writable by others")
    return os.path.join(root, slug)


# ---------------------------------------------------------------------------
# System commands and facts
# ---------------------------------------------------------------------------


def bin_path(name):
    found = shutil.which(name, path=SAFE_PATH)
    if not found:
        raise HelperError(f"{name} is not installed")
    return found


def run(argv, *, timeout=30.0, check=False):
    env = {"PATH": SAFE_PATH, "LANG": "C", "LC_ALL": "C"}
    try:
        proc = subprocess.run(
            argv, capture_output=True, text=True, timeout=timeout, env=env,
            stdin=subprocess.DEVNULL,
        )
    except subprocess.TimeoutExpired:
        raise HelperError(f"{os.path.basename(argv[0])} timed out")
    if check and proc.returncode != 0:
        raise HelperError(
            f"{os.path.basename(argv[0])} failed: {(proc.stderr or proc.stdout).strip()[:200]}"
        )
    return proc


def unit_active(unit):
    out = run([bin_path("systemctl"), "is-active", unit]).stdout.strip()
    return out in ("active", "activating", "reloading")


def ip_json(*args):
    proc = run([bin_path("ip"), "-j", "-4", *args])
    try:
        return json.loads(proc.stdout or "[]")
    except ValueError:
        return []


def forbidden_networks(exclude_iface=None):
    """Networks a VPN route may never overlap: the box's own addresses and
    routes (local, docker, other VPNs), its gateways and DNS servers."""
    nets = list(ALWAYS_FORBIDDEN)
    for link in ip_json("addr", "show"):
        if link.get("ifname") == exclude_iface:
            continue
        for info in link.get("addr_info") or []:
            with contextlib.suppress(ValueError, KeyError):
                iface = ipaddress.IPv4Interface(f"{info['local']}/{info.get('prefixlen', 32)}")
                nets += [iface.network, ipaddress.IPv4Network(f"{iface.ip}/32")]
    for route in ip_json("route", "show", "table", "all"):
        if route.get("dev") == exclude_iface:
            continue
        dst = route.get("dst")
        if dst and dst != "default":
            with contextlib.suppress(ValueError):
                nets.append(ipaddress.IPv4Network(dst, strict=False))
        if route.get("gateway"):
            with contextlib.suppress(ValueError):
                nets.append(ipaddress.IPv4Network(f"{route['gateway']}/32"))
    for path in RESOLV_FILES:
        with contextlib.suppress(OSError):
            with open(path, encoding="utf-8") as fh:
                for line in fh:
                    bits = line.split()
                    if len(bits) >= 2 and bits[0] == "nameserver":
                        with contextlib.suppress(ValueError):
                            nets.append(ipaddress.IPv4Network(f"{bits[1]}/32"))
    return nets


def check_routes_against_box(routes, gateway_ips, exclude_iface=None):
    forbidden = forbidden_networks(exclude_iface)
    for text in routes:
        net = ipaddress.IPv4Network(text)
        for ip in gateway_ips:
            if ipaddress.IPv4Address(ip) in net:
                raise InputError(f"route {net} contains the VPN gateway's own address {ip}")
        for bad in forbidden:
            if net.overlaps(bad):
                raise InputError(f"route {net} overlaps this server's network {bad}")


def resolve_ipv4(host):
    try:
        ipaddress.IPv4Address(host)
        return [host]
    except ValueError:
        pass
    infos = socket.getaddrinfo(host, None, socket.AF_INET, socket.SOCK_STREAM)
    return sorted({info[4][0] for info in infos})


def dns_query_a(name, server, iface, timeout=3.0):
    """One A lookup against the VPN's DNS server, bound to the tunnel."""
    qid = random.randint(0, 0xFFFF)
    qname = b"".join(
        bytes([len(label)]) + label.encode("ascii") for label in name.rstrip(".").split(".")
    ) + b"\0"
    packet = struct.pack(">HHHHHH", qid, 0x0100, 1, 0, 0, 0) + qname + struct.pack(">HH", 1, 1)
    sock = socket.socket(socket.AF_INET, socket.SOCK_DGRAM)
    try:
        sock.setsockopt(
            socket.SOL_SOCKET, getattr(socket, "SO_BINDTODEVICE", 25), iface.encode() + b"\0"
        )
        sock.settimeout(timeout)
        sock.sendto(packet, (server, 53))
        data = sock.recv(4096)
    finally:
        sock.close()
    rid, flags, qd, an = struct.unpack(">HHHH", data[:8])
    if rid != qid or flags & 0x000F:
        return []
    pos = 12

    def skip_name(p):
        while True:
            length = data[p]
            if length & 0xC0 == 0xC0:
                return p + 2
            if length == 0:
                return p + 1
            p += length + 1

    for _ in range(qd):
        pos = skip_name(pos) + 4
    found = []
    for _ in range(an):
        pos = skip_name(pos)
        rtype, _cls, _ttl, rdlen = struct.unpack(">HHIH", data[pos:pos + 10])
        pos += 10
        if rtype == 1 and rdlen == 4:
            found.append(socket.inet_ntoa(data[pos:pos + 4]))
        pos += rdlen
    return found


def _cert_info(der):
    info = {"sha256": hashlib.sha256(der).hexdigest(), "subject": None,
            "issuer": None, "not_after": None}
    decode = getattr(getattr(ssl, "_ssl", None), "_test_decode_cert", None)
    if decode is None:
        return info
    fd, tmp = tempfile.mkstemp(suffix=".pem")
    try:
        with os.fdopen(fd, "w") as fh:
            fh.write(ssl.DER_cert_to_PEM_cert(der))
        decoded = decode(tmp)
    except Exception:  # noqa: BLE001 - best-effort display data
        return info
    finally:
        remove(tmp)

    def name_of(rdns):
        fields = {k: v for rdn in rdns or () for (k, v) in rdn}
        return fields.get("commonName") or fields.get("organizationName") or (
            ", ".join(f"{k}={v}" for k, v in fields.items()) or None
        )

    info["subject"] = name_of(decoded.get("subject"))
    info["issuer"] = name_of(decoded.get("issuer"))
    with contextlib.suppress(Exception):
        seconds = ssl.cert_time_to_seconds(decoded["notAfter"])
        info["not_after"] = datetime.fromtimestamp(seconds, timezone.utc).strftime(
            "%Y-%m-%dT%H:%M:%SZ"
        )
    return info


def fetch_cert(host, ip, port):
    """(cert_info, system_trusted). Raises OSError when unreachable."""
    sni = None if host == ip else host
    ctx = ssl.SSLContext(ssl.PROTOCOL_TLS_CLIENT)
    ctx.check_hostname = False
    ctx.verify_mode = ssl.CERT_NONE
    with contextlib.suppress(ssl.SSLError):
        ctx.set_ciphers("DEFAULT:@SECLEVEL=0")
    with socket.create_connection((ip, port), timeout=CERT_TIMEOUT) as raw:
        with ctx.wrap_socket(raw, server_hostname=sni) as tls:
            der = tls.getpeercert(binary_form=True)
    if not der:
        raise OSError("gateway sent no certificate")
    trusted = False
    verify = ssl.create_default_context()
    try:
        with socket.create_connection((ip, port), timeout=CERT_TIMEOUT) as raw:
            with verify.wrap_socket(raw, server_hostname=host):
                trusted = True
    except (ssl.SSLError, ssl.CertificateError, OSError):
        trusted = False
    return _cert_info(der), trusted


def iface_counters(iface):
    total = 0
    for name in ("rx_bytes", "tx_bytes"):
        with open(os.path.join(SYS_NET, iface, "statistics", name), encoding="utf-8") as fh:
            total += int(fh.read().strip() or 0)
    return total


def iface_bytes(iface):
    out = {}
    for name in ("rx_bytes", "tx_bytes"):
        try:
            with open(os.path.join(SYS_NET, iface, "statistics", name), encoding="utf-8") as fh:
                out[name] = int(fh.read().strip() or 0)
        except (OSError, ValueError):
            out[name] = None
    return out


def is_mounted(path):
    target = os.path.abspath(path)
    try:
        with open(PROC_MOUNTS, encoding="utf-8") as fh:
            for line in fh:
                bits = line.split()
                if len(bits) > 1 and bits[1].replace("\\040", " ") == target:
                    return True
    except OSError:
        pass
    return False


