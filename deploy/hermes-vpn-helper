def spec_fingerprint(spec):
    return hashlib.sha256(json.dumps(spec, sort_keys=True, default=str).encode()).hexdigest()


def lookup_share_ip(server, info, iface):
    """Public DNS first, then the VPN's DNS servers through the tunnel."""
    try:
        return resolve_ipv4(server)[0]
    except (OSError, IndexError):
        pass
    names = [server] + ([f"{server}.{info['suffix']}"] if info.get("suffix") and "." not in server else [])
    for name in names:
        for ns in info.get("dns") or []:
            with contextlib.suppress(OSError, struct.error, IndexError, UnicodeError):
                found = dns_query_a(name, ns, iface)
                if found:
                    return found[0]
    return None


SMB_DIALECTS = ("default", "2.0")
NO_UTF8_MESSAGE = ("The server is missing the kernel's UTF-8 file name support "
                   "(install linux-modules-extra-$(uname -r))")


def _dialect_refused(detail):
    return "error(95)" in detail or "operation not supported" in detail


def mount_cifs(share, target, creds_path, share_ip):
    """Mount read-only; returns None or a user-readable error.

    ``vers=default`` lets client and server agree on SMB 3.1.1/3.0/2.1; SMB 2.0
    is tried only when the server refuses those. SMB 1.0 is never used.
    """
    server, share_name, subs = share
    unc = "//" + "/".join([server, share_name, *subs])
    for vers in SMB_DIALECTS:
        options = ",".join([
            "ro", "nosuid", "nodev", "noexec", f"uid={MOUNT_USER}", f"gid={MOUNT_USER}",
            "file_mode=0440", "dir_mode=0550", "iocharset=utf8",
            f"credentials={creds_path}", f"vers={vers}", f"ip={share_ip}",
        ])
        try:
            proc = run([bin_path("mount"), "-t", "cifs", unc, target, "-o", options],
                       timeout=MOUNT_TIMEOUT)
        except HelperError:
            proc = None
        if proc is not None and proc.returncode == 0:
            return None
        detail = ((proc.stderr or proc.stdout) if proc else "timed out").lower()
        if not _dialect_refused(detail):
            break
    else:
        return (f"File server {server} only offers SMB 1.0, which is not used because it is "
                "insecure; ask IT to turn on SMB 2 or 3 on it")
    if "error(79)" in detail or "iocharset" in detail or "shared library" in detail:
        return NO_UTF8_MESSAGE
    if "permission denied" in detail or "error(13)" in detail:
        return "File share login failed: check the file share username and password"
    if "no such file" in detail or "error(2)" in detail:
        return f"Share {unc} was not found on the file server"
    if "timed out" in detail or "host is down" in detail or "unreachable" in detail:
        return f"File server {server} is not reachable through the VPN"
    return f"Could not mount {unc}"


def unmount(path):
    """Unmount (lazily if busy) and remove the empty mount point."""
    if is_mounted(path):
        umount = bin_path("umount")
        try:
            done = run([umount, path], timeout=15).returncode == 0
        except HelperError:
            done = False
        if not done:
            run([umount, "-l", path], timeout=15)
    if os.path.isdir(path) and not os.path.islink(path) and not is_mounted(path):
        with contextlib.suppress(OSError):
            os.rmdir(path)


def folders_of(slug, state):
    """Folder slugs mounted through VPN ``slug`` (its state + folder states)."""
    found = {f for f in (state.get("folders") or {}) if isinstance(f, str) and SLUG_RE.fullmatch(f)}
    with contextlib.suppress(OSError):
        for name in os.listdir(RUN_DIR):
            folder = name[len(FOLDER_PREFIX):]
            if name.startswith(FOLDER_PREFIX) and SLUG_RE.fullmatch(folder):
                if load_state(name).get("vpn_slug") == slug:
                    found.add(folder)
    return sorted(found)


def status_doc(slug):
    p = paths(slug)
    state = load_state(slug)
    active = unit_active(p["unit"]) if state else False
    iface = state.get("iface")
    up = bool(active and iface and os.path.isdir(os.path.join(SYS_NET, iface)))
    doc = {
        "slug": slug, "state": "disconnected", "since": None, "local_ip": None,
        "iface": None, "error": state.get("last_error"), "rx_bytes": None,
        "tx_bytes": None, "mounted": is_mounted(p["mount"]), "mount_path": p["mount"],
        "routes": state.get("routes") or [], "cert": None,
        "last_activity": state.get("last_activity"), "share_error": None,
    }
    phase = state.get("phase")
    if phase == "needs_cert":
        doc.update(state="needs_cert", cert=state.get("cert"))
    elif phase == "connecting" and (lock_busy(slug) or active):
        doc["state"] = "connecting"
    elif phase == "connected" and up:
        doc.update(state="connected", since=state.get("since"), local_ip=state.get("local_ip"),
                   iface=iface, error=None, share_error=state.get("share_error"),
                   **iface_bytes(iface))
    elif phase == "connected":
        doc.update(state="error", error="The VPN connection dropped")
    elif doc["error"]:
        doc["state"] = "error"
    return doc


def do_down(slug, *, error=None):
    p = paths(slug)
    state = load_state(slug)
    with contextlib.suppress(HelperError):
        run([bin_path("systemctl"), "stop", f"{p['timer']}.timer"], timeout=20)
    for folder in folders_of(slug, state):
        fp = folder_paths(folder)
        unmount(fp["mount"])
        save_state(fp["name"], {"vpn_slug": slug, "last_error": error})
    if is_mounted(p["mount"]):
        umount = bin_path("umount")
        try:
            done = run([umount, p["mount"]], timeout=15).returncode == 0
        except HelperError:
            done = False
        if not done:
            run([umount, "-l", p["mount"]], timeout=15)
    iface = state.get("iface")
    if iface and IFACE_RE.fullmatch(iface):
        for route in state.get("routes") or []:
            with contextlib.suppress(HelperError):
                run([bin_path("ip"), "-4", "route", "del", route, "dev", iface], timeout=10)
    systemctl = bin_path("systemctl")
    run([systemctl, "stop", p["unit"]], timeout=30)
    run([systemctl, "reset-failed", p["unit"]], timeout=10)
    remove(p["conf"])
    remove(p["creds"])
    if os.path.isdir(p["mount"]) and not is_mounted(p["mount"]):
        with contextlib.suppress(OSError):
            os.rmdir(p["mount"])
    save_state(slug, {"phase": "disconnected", "last_error": error})


def _fail(slug, message, *, state="error", cert=None):
    do_down(slug, error=None if state == "needs_cert" else message)
    if state == "needs_cert":
        save_state(slug, {"phase": "needs_cert", "cert": cert, "last_error": None})
    return status_doc(slug)


def mount_vpn_share(slug, spec, target, share_ip):
    """Mount the VPN's own share; a failure is returned, not fatal to the tunnel."""
    p = paths(slug)
    write_private(p["creds"], render_smb_credentials(spec))
    try:
        return mount_cifs(spec["share"], target, p["creds"], share_ip)
    finally:
        remove(p["creds"])


def _covered(ip, routes):
    try:
        return any(ipaddress.IPv4Address(ip) in ipaddress.IPv4Network(r) for r in routes)
    except ValueError:
        return False


def add_tunnel_route(state, cidr, iface):
    """Add ``cidr`` on the tunnel after the box-overlap checks; error or None."""
    try:
        check_route(cidr)
        gateways = [g for g in state.get("gateway_ips") or [] if isinstance(g, str)]
        check_routes_against_box([cidr], gateways, exclude_iface=iface)
    except InputError as exc:
        return str(exc)
    if run([bin_path("ip"), "-4", "route", "replace", cidr, "dev", iface]).returncode != 0:
        return f"Could not add route {cidr}"
    routes = state.setdefault("routes", [])
    if cidr not in routes:
        routes.append(cidr)
    return None


def claim_folder_route(state, folder, share_ip, iface):
    """Make the tunnel reach ``share_ip`` for ``folder``; error or None.

    Covered by the VPN's own routes: nothing to do. Otherwise ``<ip>/32`` is
    added (or shared with other folders) and ``folder`` recorded as a user.
    """
    cidr = f"{share_ip}/32"
    owned = state.setdefault("folder_routes", {})
    if cidr in owned:
        users = [u for u in owned[cidr] if isinstance(u, str)]
        owned[cidr] = sorted(set(users) | {folder})
        return None
    if _covered(share_ip, [r for r in state.get("routes") or [] if isinstance(r, str)]):
        return None
    error = add_tunnel_route(state, cidr, iface)
    if error:
        return error
    owned[cidr] = [folder]
    return None


def release_folder_routes(state, folder, iface, *, keep=None):
    """Drop ``folder`` from every folder route but ``keep``; a route no
    folder uses any more comes off the tunnel. Returns True if state changed."""
    owned = state.get("folder_routes")
    if not isinstance(owned, dict):
        return False
    changed = False
    for cidr, users in list(owned.items()):
        if cidr == keep or not isinstance(users, list) or folder not in users:
            continue
        changed = True
        rest = [u for u in users if u != folder]
        if rest:
            owned[cidr] = rest
            continue
        del owned[cidr]
        state["routes"] = [r for r in state.get("routes") or [] if r != cidr]
        try:
            net = ipaddress.IPv4Network(cidr)
        except ValueError:
            continue
        if net.prefixlen == 32 and IFACE_RE.fullmatch(iface or ""):
            with contextlib.suppress(HelperError):
                run([bin_path("ip"), "-4", "route", "del", str(net), "dev", iface], timeout=10)
    return changed


def retry_vpn_share(slug, spec, state):
    """Mount the VPN's own share again on a live tunnel; the error or None."""
    iface = state.get("iface") or ""
    if not IFACE_RE.fullmatch(iface):
        return "VPN is not connected"
    server = spec["share"][0]
    share_ip = lookup_share_ip(server, parse_log(read_log(slug)), iface)
    if not share_ip:
        return f"Can't find the file server {server} (not in public or VPN DNS)"
    routes = [r for r in state.get("routes") or [] if isinstance(r, str)]
    if not _covered(share_ip, routes):
        if spec["routes"]:
            return f"File server {server} ({share_ip}) is outside the VPN routes {', '.join(routes)}"
        error = add_tunnel_route(state, f"{share_ip}/32", iface)
        if error:
            return error
    try:
        target = secure_mount_point(slug)
    except HelperError as exc:
        return str(exc)
    return mount_vpn_share(slug, spec, target, share_ip)


def cmd_up(spec_path):
    spec = validate_spec(read_spec_file(spec_path))
    slug = spec["slug"]
    fp = spec_fingerprint(spec)
    with slug_lock(slug):
        current = status_doc(slug)
        prior = load_state(slug)
        if current["state"] == "connected" and prior.get("fingerprint") == fp:
            prior["last_activity"] = now_iso()
            if spec["share"] and not current["mounted"]:
                prior["share_error"] = retry_vpn_share(slug, spec, prior)
            save_state(slug, prior)
            return status_doc(slug)
        do_down(slug)
        save_state(slug, {"phase": "connecting"})
        try:
            gateway_ips = resolve_ipv4(spec["host"])
        except OSError:
            return _fail(slug, f"Can't find the VPN server {spec['host']}")
        check_routes_against_box(spec["routes"], gateway_ips)
        try:
            cert, trusted = fetch_cert(spec["host"], gateway_ips[0], spec["port"])
        except OSError as exc:
            reason = exc.strerror or str(exc) or "no answer"
            return _fail(slug, f"Can't reach the VPN server {spec['host']}:{spec['port']} ({reason[:80]})")
        if not trusted and cert["sha256"] != spec["trusted_cert"]:
            return _fail(slug, "certificate not trusted", state="needs_cert", cert=cert)
        p = paths(slug)
        write_private(p["conf"], render_openfortivpn_config(spec))
        write_private(p["log"], "")
        run([
            bin_path("systemd-run"), f"--unit={p['unit']}", "--collect", "--quiet",
            f"--property=StandardOutput=append:{p['log']}",
            f"--property=StandardError=append:{p['log']}",
            "--", bin_path("openfortivpn"), "-c", p["conf"],
        ], check=True)
        deadline = time.monotonic() + UP_TIMEOUT
        info = parse_log("")
        while time.monotonic() < deadline:
            text = read_log(slug)
            info = parse_log(text)
            if info["up"] and info["iface"]:
                break
            if "ERROR:" in text or not unit_active(p["unit"]):
                time.sleep(0.5)
                text = read_log(slug)
                kind, message, digest = classify_log(text, spec["host"], spec["port"])
                if kind == "needs_cert":
                    cert = dict(cert, sha256=digest or cert["sha256"])
                    return _fail(slug, message, state="needs_cert", cert=cert)
                return _fail(slug, message)
            time.sleep(0.5)
        else:
            return _fail(slug, f"Timed out after {int(UP_TIMEOUT)}s waiting for the VPN tunnel")
        remove(p["conf"])
        iface = info["iface"]
        if not IFACE_RE.fullmatch(iface or ""):
            return _fail(slug, "VPN client reported an unexpected interface")
        state = {"phase": "connecting", "iface": iface, "routes": [], "fingerprint": fp,
                 "gateway_ips": gateway_ips}
        save_state(slug, state)
        routes = list(spec["routes"])
        share_ip = None
        share_error = None
        if spec["share"]:
            server = spec["share"][0]
            share_ip = lookup_share_ip(server, info, iface)
            if not share_ip:
                return _fail(slug, f"Can't find the file server {server} (not in public or VPN DNS)")
            if not routes:
                routes = [f"{share_ip}/32"]
                check_route(routes[0])
            if not any(ipaddress.IPv4Address(share_ip) in ipaddress.IPv4Network(r) for r in routes):
                return _fail(slug, f"File server {server} ({share_ip}) is outside the VPN routes {', '.join(routes)}")
        try:
            check_routes_against_box(routes, gateway_ips, exclude_iface=iface)
        except InputError as exc:
            return _fail(slug, str(exc))
        for route in routes:
            proc = run([bin_path("ip"), "-4", "route", "replace", route, "dev", iface])
            if proc.returncode != 0:
                return _fail(slug, f"Could not add route {route}")
            state["routes"].append(route)
            save_state(slug, state)
        if spec["share"]:
            try:
                target = secure_mount_point(slug)
            except HelperError as exc:
                return _fail(slug, str(exc))
            share_error = mount_vpn_share(slug, spec, target, share_ip)
        if spec["idle_minutes"] > 0:
            run([
                bin_path("systemd-run"), f"--unit={p['timer']}", "--collect", "--quiet",
                f"--on-active={IDLE_CHECK_SECONDS}", f"--on-unit-active={IDLE_CHECK_SECONDS}",
                "--timer-property=AccuracySec=5s", "--", SELF_PATH, "idle-check", slug,
            ])
        state.update(
            phase="connected", since=now_iso(), local_ip=info["local_ip"],
            idle_minutes=spec["idle_minutes"], last_activity=now_iso(),
            last_bytes=_safe_counters(iface), last_error=None, share_error=share_error,
        )
        save_state(slug, state)
        return status_doc(slug)


def _safe_counters(iface):
    try:
        return iface_counters(iface)
    except (OSError, ValueError):
        return None


def cmd_down(slug):
    check_vpn_slug(slug)
    with slug_lock(slug):
        do_down(slug)
        return status_doc(slug)


def cmd_status(slug):
    check_vpn_slug(slug)
    return status_doc(slug)


def count_files(root, deadline):
    """(count, stop) — stop is None, ``"time"`` or ``"entries"``."""
    count = 0
    stack = [root]
    while stack:
        if time.monotonic() > deadline:
            return count, "time"
        if count >= CHECK_MAX_ENTRIES:
            return count, "entries"
        with os.scandir(stack.pop()) as entries:
            for entry in entries:
                if entry.is_dir(follow_symlinks=False):
                    stack.append(entry.path)
                else:
                    count += 1
    return count, None


def cmd_check(slug):
    check_vpn_slug(slug)
    doc = status_doc(slug)
    at = now_iso()
    if doc["state"] != "connected":
        doc["check"] = {"at": at, "ok": False, "file_count": None,
                        "message": doc["error"] or "VPN is not connected"}
        return doc
    with slug_lock(slug):
        state = load_state(slug)
        state["last_activity"] = at
        save_state(slug, state)
    if not doc["mounted"] and doc["share_error"]:
        doc["check"] = {"at": at, "ok": False, "file_count": None,
                        "message": f"VPN connected, but the file share failed: {doc['share_error']}"}
        return doc
    if not doc["mounted"]:
        doc["check"] = {"at": at, "ok": True, "file_count": None,
                        "message": "VPN connected; no file share is configured."}
        return doc
    doc["check"] = dict(walk_check(doc["mount_path"]), at=at)
    return doc


def walk_check(root):
    """Count files under ``root`` with a deadline; a ``check`` dict (no ``at``)."""
    result = {}

    def walk():
        try:
            result["count"], result["partial"] = count_files(
                root, time.monotonic() + CHECK_TIMEOUT
            )
        except OSError as exc:
            result["error"] = exc.strerror or str(exc)

    worker = threading.Thread(target=walk, daemon=True)
    worker.start()
    worker.join(CHECK_TIMEOUT + CHECK_GRACE)
    if worker.is_alive():
        check = {"ok": False, "file_count": None, "message": slow_message()}
    elif "error" in result:
        check = {"ok": False, "file_count": None,
                 "message": f"File server error: {result['error'][:120]}"}
    else:
        n = result["count"]
        if result["partial"] == "time":
            message = (f"File server reachable, at least {n:,} files "
                       f"(stopped counting after {CHECK_TIMEOUT:g} s).")
        elif result["partial"]:
            message = f"File server reachable, at least {n:,} files (stopped counting)."
        else:
            message = f"File server reachable, {n:,} files listed."
        check = {"ok": True, "file_count": n, "message": message}
    return check


def slow_message():
    return (f"File server is too slow to answer "
            f"(no reply within {CHECK_TIMEOUT + CHECK_GRACE:g} s).")


def cmd_idle_check(slug):
    check_vpn_slug(slug)
    with slug_lock(slug, blocking=False) as got:
        if not got:
            return status_doc(slug)
        state = load_state(slug)
        if state.get("phase") != "connected":
            with contextlib.suppress(HelperError):
                run([bin_path("systemctl"), "stop", f"{paths(slug)['timer']}.timer"], timeout=20)
            return status_doc(slug)
        iface = state.get("iface") or ""
        if not unit_active(paths(slug)["unit"]) or not os.path.isdir(os.path.join(SYS_NET, iface)):
            do_down(slug, error="The VPN connection dropped")
            return status_doc(slug)
        total = _safe_counters(iface)
        last = state.get("last_bytes")
        if total is not None and (last is None or abs(total - last) > IDLE_NOISE_BYTES):
            state["last_activity"] = now_iso()
        state["last_bytes"] = total
        save_state(slug, state)
        idle = int(state.get("idle_minutes") or 0)
        try:
            since = datetime.strptime(state.get("last_activity") or "", "%Y-%m-%dT%H:%M:%SZ")
            quiet = (datetime.now(timezone.utc) - since.replace(tzinfo=timezone.utc)).total_seconds()
        except ValueError:
            quiet = 0
        if idle and quiet >= idle * 60:
            do_down(slug)
        return status_doc(slug)


# ---------------------------------------------------------------------------
# Network folders (Folder Bridge): extra read-only mounts through a VPN
# ---------------------------------------------------------------------------


def folder_doc(folder_slug):
    fp = folder_paths(folder_slug)
    state = load_state(fp["name"])
    vpn_slug = state.get("vpn_slug")
    if not (isinstance(vpn_slug, str) and SLUG_RE.fullmatch(vpn_slug)):
        vpn_slug = None
    return {
        "folder_slug": folder_slug, "vpn_slug": vpn_slug,
        "mounted": is_mounted(fp["mount"]), "mount_path": fp["mount"],
        "error": state.get("last_error"), "since": state.get("since"),
    }


def _folder_fail(folder_slug, vpn_slug, message):
    fp = folder_paths(folder_slug)
    if not is_mounted(fp["mount"]) and os.path.isdir(fp["mount"]) and not os.path.islink(fp["mount"]):
        with contextlib.suppress(OSError):
            os.rmdir(fp["mount"])
    save_state(fp["name"], {"vpn_slug": vpn_slug, "last_error": message})
    return folder_doc(folder_slug)


def _folder_drop_route(state, vpn_slug, folder, iface, message):
    """A failed mount gives back the folder's tunnel route."""
    if release_folder_routes(state, folder, iface):
        save_state(vpn_slug, state)
    return _folder_fail(folder, vpn_slug, message)


def cmd_mount(spec_path):
    spec = validate_mount_spec(read_spec_file(spec_path))
    vpn_slug, folder = spec["vpn_slug"], spec["folder_slug"]
    fp = folder_paths(folder)
    fingerprint = spec_fingerprint(spec)
    prior = load_state(fp["name"])
    old_vpn = prior.get("vpn_slug")
    if (isinstance(old_vpn, str) and old_vpn != vpn_slug and SLUG_RE.fullmatch(old_vpn)
            and not old_vpn.startswith(FOLDER_PREFIX)):
        with slug_lock(old_vpn):
            unmount(fp["mount"])
            old = load_state(old_vpn)
            changed = release_folder_routes(old, folder, old.get("iface"))
            if folder in (old.get("folders") or {}):
                old["folders"].pop(folder, None)
                changed = True
            if changed:
                save_state(old_vpn, old)
    with slug_lock(vpn_slug):
        vpn = status_doc(vpn_slug)
        if vpn["state"] != "connected":
            unmount(fp["mount"])
            return _folder_fail(folder, vpn_slug, "VPN is not connected")
        state = load_state(vpn_slug)
        mounted = is_mounted(fp["mount"])
        if (mounted and prior.get("fingerprint") == fingerprint
                and prior.get("vpn_slug") == vpn_slug and folder in (state.get("folders") or {})):
            state["last_activity"] = now_iso()
            save_state(vpn_slug, state)
            return folder_doc(folder)
        unmount(fp["mount"])
        iface = state.get("iface") or ""
        if not IFACE_RE.fullmatch(iface):
            return _folder_fail(folder, vpn_slug, "VPN is not connected")
        server = spec["share"][0]
        share_ip = lookup_share_ip(server, parse_log(read_log(vpn_slug)), iface)
        if not share_ip:
            return _folder_drop_route(
                state, vpn_slug, folder, iface,
                f"Can't find the file server {server} (not in public or VPN DNS)",
            )
        state.get("folders", {}).pop(folder, None)
        release_folder_routes(state, folder, iface, keep=f"{share_ip}/32")
        error = claim_folder_route(state, folder, share_ip, iface)
        save_state(vpn_slug, state)
        if error:
            return _folder_drop_route(state, vpn_slug, folder, iface, error)
        try:
            target = secure_mount_point(fp["name"])
        except HelperError as exc:
            return _folder_drop_route(state, vpn_slug, folder, iface, str(exc))
        creds = os.path.join(paths(vpn_slug)["dir"], f"{fp['name']}.cred")
        write_private(creds, render_folder_credentials(spec))
        try:
            message = mount_cifs(spec["share"], target, creds, share_ip)
        finally:
            remove(creds)
        if message:
            return _folder_drop_route(state, vpn_slug, folder, iface, message)
        at = now_iso()
        state.setdefault("folders", {})[folder] = {"since": at}
        state["last_activity"] = at
        save_state(vpn_slug, state)
        save_state(fp["name"], {"vpn_slug": vpn_slug, "fingerprint": fingerprint,
                                "last_error": None, "since": at})
        return folder_doc(folder)


def cmd_umount(folder_slug):
    fp = folder_paths(folder_slug)
    vpn_slug = folder_doc(folder_slug)["vpn_slug"]
    if vpn_slug and not vpn_slug.startswith(FOLDER_PREFIX):
        with slug_lock(vpn_slug):
            unmount(fp["mount"])
            state = load_state(vpn_slug)
            changed = release_folder_routes(state, folder_slug, state.get("iface"))
            if folder_slug in (state.get("folders") or {}):
                state["folders"].pop(folder_slug, None)
                changed = True
            if changed:
                save_state(vpn_slug, state)
    else:
        unmount(fp["mount"])
    save_state(fp["name"], {"vpn_slug": vpn_slug, "last_error": None})
    return folder_doc(folder_slug)


def cmd_fstatus(folder_slug):
    doc = folder_doc(folder_slug)
    doc["vpn_state"] = status_doc(doc["vpn_slug"])["state"] if doc["vpn_slug"] else "disconnected"
    return doc


def cmd_fcheck(folder_slug):
    doc = cmd_fstatus(folder_slug)
    at = now_iso()
    if not doc["mounted"]:
        doc["check"] = {"at": at, "ok": False, "file_count": None,
                        "message": doc["error"] or "Network folder is not mounted"}
        return doc
    if doc["vpn_slug"]:
        with slug_lock(doc["vpn_slug"]):
            state = load_state(doc["vpn_slug"])
            if state.get("phase") == "connected":
                state["last_activity"] = at
                save_state(doc["vpn_slug"], state)
    doc["check"] = dict(walk_check(doc["mount_path"]), at=at)
    return doc


def main(argv=None):
    argv = list(sys.argv[1:] if argv is None else argv)
    os.environ["PATH"] = SAFE_PATH
    os.umask(0o077)
    commands = {"up": cmd_up, "down": cmd_down, "status": cmd_status,
                "check": cmd_check, "idle-check": cmd_idle_check, "mount": cmd_mount,
                "umount": cmd_umount, "fstatus": cmd_fstatus, "fcheck": cmd_fcheck}
    try:
        if len(argv) != 2 or argv[0] not in commands:
            raise InputError(
                "usage: hermes-vpn-helper up|mount <spec.json> | down|status|check|idle-check <slug>"
                " | umount|fstatus|fcheck <folder_slug>"
            )
        if os.geteuid() != 0:
            raise HelperError("hermes-vpn-helper must run as root (use sudo -n)")
        doc = commands[argv[0]](argv[1])
    except InputError as exc:
        print(json.dumps({"error": str(exc), "bad_input": True}))
        return 2
    except (HelperError, OSError) as exc:
        message = str(exc) if isinstance(exc, HelperError) else f"{exc.strerror or exc}"
        print(json.dumps({"error": message[:300]}))
        return 1
    print(json.dumps(doc))
    return 0


if __name__ == "__main__":
    sys.exit(main())
