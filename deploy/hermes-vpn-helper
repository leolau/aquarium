#!/usr/bin/python3 -I
"""hermes-vpn-helper: root side of Hermes "Private networks (VPN)".

Installed root:root 0755 at /usr/local/sbin/hermes-vpn-helper; user ``hermes``
may run it through sudo (deploy/sudoers.d/hermes-vpn). The caller is
UNTRUSTED: every argument and every spec field is validated here, the
openfortivpn config is generated from an allowlist, and only validated IPv4
routes are added on the tunnel interface. The box's default route, DNS and
local/docker networks are never touched.

    hermes-vpn-helper up <spec.json>   # spec: 0600 file owned by the caller; read, then deleted
    hermes-vpn-helper down <slug>
    hermes-vpn-helper status <slug>
    hermes-vpn-helper check <slug>     # list the mounted share, count files
    hermes-vpn-helper idle-check <slug>  # run by the per-VPN systemd timer
    hermes-vpn-helper mount <spec.json>  # network folder: mount one more share through a connected VPN
    hermes-vpn-helper umount <folder_slug>
    hermes-vpn-helper fstatus <folder_slug>
    hermes-vpn-helper fcheck <folder_slug>   # list the mounted folder, count files

Network folders (Folder Bridge) mount at ``MOUNT_ROOT/net-<folder_slug>``; a
VPN slug may therefore never start with ``net-``. A folder mount belongs to
the VPN it was mounted through: ``down``/idle disconnect unmount it too. A VPN
needs no routes or share of its own: mounting a folder whose file server the
tunnel doesn't reach yet adds ``<server_ip>/32`` on the tunnel (recorded in
the VPN state as ``folder_routes``) and the last folder using it removes it.

Output is one JSON object on stdout. Exit 0 = handled (a failed connection is
``state: error``, not an exit code), 2 = rejected input, 1 = internal failure.
Python 3 stdlib only.
"""

import contextlib
import errno
import fcntl
import hashlib
import ipaddress
import json
import os
import random
import re
import shutil
import socket
import ssl
import stat
import struct
import subprocess
import sys
import tempfile
import threading
import time
from datetime import datetime, timezone

SAFE_PATH = "/usr/sbin:/usr/bin:/sbin:/bin"
RUN_DIR = "/run/hermes-vpn"
MOUNT_ROOT = "/opt/data/vpn-files"
SYS_NET = "/sys/class/net"
PROC_MOUNTS = "/proc/self/mounts"
SELF_PATH = "/usr/local/sbin/hermes-vpn-helper"
MOUNT_USER = "hermes"
#: Owners allowed on every directory from / down to MOUNT_ROOT.
TRUSTED_UIDS = (0,)
RESOLV_FILES = ("/etc/resolv.conf", "/run/systemd/resolve/resolv.conf")

UP_TIMEOUT = 60.0
CERT_TIMEOUT = 10.0
MOUNT_TIMEOUT = 45.0
CHECK_TIMEOUT = 20.0
#: Extra wait for a walker blocked inside one directory listing.
CHECK_GRACE = 5.0
CHECK_MAX_ENTRIES = 200_000
IDLE_CHECK_SECONDS = 60
#: Bytes per idle-check interval that still count as "no traffic": SMB echo
#: and PPP LCP keepalives move a few hundred bytes a minute on an idle link.
IDLE_NOISE_BYTES = 4096
MAX_ROUTES = 32
MAX_SPEC_BYTES = 64 * 1024

SLUG_RE = re.compile(r"^[a-z0-9][a-z0-9-]{0,40}$")
IFACE_RE = re.compile(r"^ppp[0-9]{1,4}$")
SHA256_RE = re.compile(r"^[0-9a-f]{64}$")
LABEL = r"[A-Za-z0-9](?:[A-Za-z0-9-]{0,61}[A-Za-z0-9])?"
HOSTNAME_RE = re.compile(rf"^(?=.{{1,253}}$){LABEL}(?:\.{LABEL})*\.?$")
REALM_RE = re.compile(r"^[A-Za-z0-9._@-]{1,128}$")
ACCOUNT_RE = re.compile(r"^[A-Za-z0-9._@ -]{1,128}$")
SHARE_RE = re.compile(r"^[A-Za-z0-9 ._$-]{1,80}$")
SUBPATH_RE = re.compile(r'^[^/\\\x00-\x1f\x7f:*?"<>|,]{1,255}$')
SPEC_NAME_RE = re.compile(r"^[A-Za-z0-9._-]{1,128}$")
CONTROL_RE = re.compile(r"[\x00-\x1f\x7f]")

SPEC_KEYS = {
    "slug", "host", "port", "username", "password", "realm", "trusted_cert",
    "routes", "share_path", "share_username", "share_password", "share_domain",
    "idle_minutes",
}
SECRET_KEYS = ("password", "share_password")
MOUNT_SPEC_KEYS = {
    "vpn_slug", "folder_slug", "share_path", "share_username", "share_password",
    "share_domain",
}
FOLDER_PREFIX = "net-"

#: Never routed through a VPN, whatever the box's tables say.
ALWAYS_FORBIDDEN = tuple(
    ipaddress.IPv4Network(n)
    for n in (
        "0.0.0.0/8", "127.0.0.0/8", "169.254.0.0/16", "224.0.0.0/4",
        "240.0.0.0/4", "172.17.0.0/16", "172.18.0.0/16",
    )
)


class InputError(Exception):
    """Rejected caller input (exit 2)."""


class HelperError(Exception):
    """Internal failure (exit 1)."""


def now_iso():
    return datetime.now(timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")


# ---------------------------------------------------------------------------
# Validation
# ---------------------------------------------------------------------------


def check_slug(slug):
    if not isinstance(slug, str) or not SLUG_RE.fullmatch(slug):
        raise InputError("invalid slug")
    return slug


def check_vpn_slug(slug):
    """A VPN slug: ``net-*`` is reserved for network-folder mount points."""
    check_slug(slug)
    if slug.startswith(FOLDER_PREFIX):
        raise InputError(f"VPN slugs may not start with {FOLDER_PREFIX}")
    return slug


def folder_name(folder_slug):
    """Run-dir and mount-dir name of a network folder (``net-<slug>``)."""
    return FOLDER_PREFIX + check_slug(folder_slug)


def _plain(value, field, *, max_len=256, required=True):
    """A config/credential value: no control chars, no edge whitespace."""
    if value is None or value == "":
        if required:
            raise InputError(f"{field} is required")
        return None
    if not isinstance(value, str):
        raise InputError(f"{field} must be a string")
    if len(value) > max_len:
        raise InputError(f"{field} is too long")
    if CONTROL_RE.search(value):
        raise InputError(f"{field} contains control characters")
    if value != value.strip():
        raise InputError(f"{field} has leading or trailing spaces")
    return value


def check_host(value, field="host"):
    if not isinstance(value, str) or not value:
        raise InputError(f"{field} is required")
    try:
        ip = ipaddress.IPv4Address(value)
    except ValueError:
        ip = None
    if ip is not None:
        if ip.is_loopback or ip.is_link_local or ip.is_unspecified or ip.is_multicast:
            raise InputError(f"{field} {value} is not a usable address")
        return value
    if not HOSTNAME_RE.fullmatch(value) or value.replace(".", "").isdigit():
        raise InputError(f"{field} must be a hostname or IPv4 address")
    return value.rstrip(".").lower()


def check_route(value):
    if not isinstance(value, str):
        raise InputError("routes must be IPv4 CIDR strings")
    try:
        net = ipaddress.IPv4Network(value, strict=True)
    except ValueError as exc:
        raise InputError(f"route {value!r} is not a valid IPv4 CIDR ({exc})")
    if net.prefixlen < 8:
        raise InputError(f"route {value} is too broad (prefix must be /8 or longer)")
    for bad in ALWAYS_FORBIDDEN:
        if net.overlaps(bad):
            raise InputError(f"route {value} overlaps reserved network {bad}")
    return net


def parse_share_path(value):
    """``//server/share[/sub]`` or ``\\\\server\\share[\\sub]`` -> (server, share, [sub])."""
    if not isinstance(value, str) or CONTROL_RE.search(value):
        raise InputError("share_path must be like //server/share")
    path = value.replace("\\", "/")
    if not path.startswith("//"):
        raise InputError("share_path must start with //server/share")
    parts = path[2:].rstrip("/").split("/")
    if len(parts) < 2 or len(parts) > 18:
        raise InputError("share_path must be like //server/share[/folder]")
    server = check_host(parts[0], "share_path server")
    share = parts[1]
    if not SHARE_RE.fullmatch(share):
        raise InputError("share_path has an invalid share name")
    subs = parts[2:]
    for sub in subs:
        if sub in (".", "..") or not SUBPATH_RE.fullmatch(sub):
            raise InputError("share_path has an invalid folder name")
    return server, share, subs


def validate_spec(raw):
    if not isinstance(raw, dict):
        raise InputError("spec must be a JSON object")
    unknown = sorted(set(raw) - SPEC_KEYS)
    if unknown:
        raise InputError(f"spec has unknown fields: {', '.join(unknown)}")
    spec = {"slug": check_vpn_slug(raw.get("slug")), "host": check_host(raw.get("host"))}
    port = raw.get("port", 443)
    if port is None:
        port = 443
    if isinstance(port, bool) or not isinstance(port, int) or not 1 <= port <= 65535:
        raise InputError("port must be an integer 1-65535")
    spec["port"] = port
    spec["username"] = _plain(raw.get("username"), "username")
    spec["password"] = _plain(raw.get("password"), "password")
    realm = raw.get("realm") or None
    if realm is not None and (not isinstance(realm, str) or not REALM_RE.fullmatch(realm)):
        raise InputError("realm may only contain letters, digits and ._@-")
    spec["realm"] = realm
    cert = raw.get("trusted_cert") or None
    if cert is not None and (not isinstance(cert, str) or not SHA256_RE.fullmatch(cert)):
        raise InputError("trusted_cert must be 64 lowercase hex characters")
    spec["trusted_cert"] = cert
    routes = raw.get("routes") or []
    if not isinstance(routes, list) or len(routes) > MAX_ROUTES:
        raise InputError(f"routes must be a list of at most {MAX_ROUTES} CIDRs")
    nets = [check_route(r) for r in routes]
    for i, a in enumerate(nets):
        for b in nets[i + 1:]:
            if a.overlaps(b):
                raise InputError(f"routes {a} and {b} overlap")
    spec["routes"] = [str(n) for n in nets]
    share = raw.get("share_path") or None
    spec["share"] = parse_share_path(share) if share else None
    spec["share_username"] = raw.get("share_username") or None
    if spec["share_username"] is not None and (
        not isinstance(spec["share_username"], str)
        or not ACCOUNT_RE.fullmatch(spec["share_username"])
    ):
        raise InputError("share_username has invalid characters")
    spec["share_domain"] = raw.get("share_domain") or None
    if spec["share_domain"] is not None and (
        not isinstance(spec["share_domain"], str)
        or not ACCOUNT_RE.fullmatch(spec["share_domain"])
    ):
        raise InputError("share_domain has invalid characters")
    spec["share_password"] = _plain(
        raw.get("share_password"), "share_password", required=False
    )
    idle = raw.get("idle_minutes", 30)
    if idle is None:
        idle = 30
    if isinstance(idle, bool) or not isinstance(idle, int) or not 0 <= idle <= 1440:
        raise InputError("idle_minutes must be an integer 0-1440")
    spec["idle_minutes"] = idle
    return spec


def _account(value, field, *, required=False):
    if value is None or value == "":
        if required:
            raise InputError(f"{field} is required")
        return None
    if not isinstance(value, str) or not ACCOUNT_RE.fullmatch(value):
        raise InputError(f"{field} has invalid characters")
    return value


def validate_mount_spec(raw):
    """``mount`` spec: credentials are already resolved by the caller."""
    if not isinstance(raw, dict):
        raise InputError("spec must be a JSON object")
    unknown = sorted(set(raw) - MOUNT_SPEC_KEYS)
    if unknown:
        raise InputError(f"spec has unknown fields: {', '.join(unknown)}")
    share = raw.get("share_path")
    if not share:
        raise InputError("share_path is required")
    return {
        "vpn_slug": check_vpn_slug(raw.get("vpn_slug")),
        "folder_slug": check_slug(raw.get("folder_slug")),
        "share": parse_share_path(share),
        "share_username": _account(raw.get("share_username"), "share_username", required=True),
        "share_password": _plain(raw.get("share_password"), "share_password", required=False),
        "share_domain": _account(raw.get("share_domain"), "share_domain"),
    }


def caller_uid():
    if os.geteuid() == 0 and os.environ.get("SUDO_UID", "").isdigit():
        return int(os.environ["SUDO_UID"])
    return os.getuid()


def read_spec_file(path):
    """Read and delete the caller's spec without following any link.

    The file must sit in a directory owned by the caller that nobody else can
    write, be a regular single-link 0600 file owned by the caller. Opening and
    unlinking go through the directory fd, so a swapped path can never make
    root read or delete a file the caller could not touch itself.
    """
    if not isinstance(path, str) or not os.path.isabs(path):
        raise InputError("spec path must be absolute")
    directory, name = os.path.split(path)
    if not SPEC_NAME_RE.fullmatch(name):
        raise InputError("bad spec file name")
    uid = caller_uid()
    try:
        dfd = os.open(directory, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW)
    except OSError as exc:
        raise InputError(f"cannot open spec directory ({exc.strerror})")
    try:
        dst = os.fstat(dfd)
        if dst.st_uid != uid or dst.st_mode & 0o022:
            raise InputError("spec directory must be owned by the caller and not shared")
        try:
            fd = os.open(name, os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK, dir_fd=dfd)
        except OSError as exc:
            raise InputError(f"cannot open spec file ({exc.strerror})")
        try:
            st = os.fstat(fd)
            if not stat.S_ISREG(st.st_mode) or st.st_nlink != 1:
                raise InputError("spec must be a regular file")
            if st.st_uid != uid or st.st_mode & 0o077:
                raise InputError("spec must be a 0600 file owned by the caller")
            if st.st_size > MAX_SPEC_BYTES:
                raise InputError("spec is too large")
            data = os.read(fd, MAX_SPEC_BYTES + 1)
        finally:
            os.close(fd)
        with contextlib.suppress(OSError):
            os.unlink(name, dir_fd=dfd)
    finally:
        os.close(dfd)
    try:
        return json.loads(data.decode("utf-8"))
    except (UnicodeDecodeError, ValueError):
        raise InputError("spec is not valid JSON")


