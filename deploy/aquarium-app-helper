def instance_dropin(conf, p):
    release = current_release(p)
    if not release:
        raise InputError(f"{p['inst']} has no built release (build first)")
    rel_dir = os.path.join(p["releases"], release)
    if not os.path.isfile(os.path.join(rel_dir, "server.js")):
        raise HelperError(f"release {release} has no server.js")
    lines = [
        "# Written by aquarium-app-helper; do not edit (rewritten on every start).",
        "[Service]",
        f"User={dynamic_user('aqapp', p['inst'])}",
        f"EnvironmentFile={p['env']}",
        # Only this release is visible: the rest of the storage base is an empty tmpfs.
        f"TemporaryFileSystem={conf['storage_base']}:ro",
        f"BindReadOnlyPaths={rel_dir}",
        f"BindPaths=%C/aquarium-app/{p['inst']}:{rel_dir}/.next/cache",
        f"WorkingDirectory={rel_dir}",
        f"Environment=APP_RELEASE={release}",
    ]
    lines += [f"LoadCredential={n}:{os.path.join(p['creds'], n)}" for n in secret_names(p)]
    lines += [f"LoadCredential={cred}:{path}" for cred, path in p["dsn"].items() if os.path.isfile(path)]
    if write_ticket_key(p):
        lines.append(f"LoadCredential=APP_TICKET_KEY:{p['ticket_key']}")
    return "\n".join(lines) + "\n", release


def ticket_master():
    """AGENT_HOME_APPS_TICKET_SECRET from agent-home's root-owned env file, or None."""
    try:
        if not _root_file_ok(AGENT_HOME_ENV):
            return None
    except FileNotFoundError:
        return None
    value = read_env(AGENT_HOME_ENV).get(TICKET_SECRET_KEY, "").strip()
    if len(value) >= 2 and value[0] == value[-1] and value[0] in "\"'":
        value = value[1:-1]
    return value or None


def write_ticket_key(p):
    """Write this instance's ticket key (hex HMAC-SHA256(master,
    "aquarium-app-ticket/v1/<slug>/<mode>"), as deriveAppKey() in
    agent-home/src/lib/apps/ticket.ts). The app holds only its own key."""
    master = ticket_master()
    if not master:
        with contextlib.suppress(FileNotFoundError):
            os.unlink(p["ticket_key"])
        return False
    slug, mode = p["inst"].rsplit("-", 1)
    key = hmac.new(master.encode(), f"aquarium-app-ticket/v1/{slug}/{mode}".encode(),
                   hashlib.sha256).hexdigest()
    trusted_dir(p["etc"], 0o700)
    write_atomic(p["ticket_key"], key, 0o600)
    return True


def write_instance_dropin(conf, p):
    text, release = instance_dropin(conf, p)
    os.makedirs(p["dropin_dir"], mode=0o755, exist_ok=True)
    write_atomic(p["dropin"], text, 0o644)
    return release


# ---------------------------------------------------------------------------
# Tar handling (artifacts are untrusted: app code ran during `next build`)
# ---------------------------------------------------------------------------


def _member_path(name):
    name = name[2:] if name.startswith("./") else name
    name = name.rstrip("/")
    if not name or name == ".":
        return None
    if name.startswith("/") or "\x00" in name or "\\" in name:
        raise InputError(f"unsafe path in archive: {name[:80]!r}")
    parts = name.split("/")
    if any(part in ("", ".", "..") for part in parts):
        raise InputError(f"unsafe path in archive: {name[:80]!r}")
    return "/".join(parts)


def _makedirs(root, path):
    """mkdir -p with 0755 whatever the umask (the runtime uid must read releases)."""
    if path == root or os.path.isdir(path):
        return
    _makedirs(root, os.path.dirname(path))
    os.mkdir(path, 0o755)
    os.chmod(path, 0o755)


def safe_extract(fileobj, dest, max_bytes, max_entries=MAX_TAR_ENTRIES):
    """Stream-extract a tar into the empty directory ``dest``.

    Regular files, directories and symlinks that stay inside ``dest`` only;
    nothing is written through a symlink; no setuid/setgid/sticky bits;
    size and entry caps."""
    links, seen, total, count = set(), set(), 0, 0
    with tarfile.open(fileobj=fileobj, mode="r|*") as tar:
        for member in tar:
            count += 1
            if count > max_entries:
                raise InputError("archive has too many entries")
            rel = _member_path(member.name)
            if rel is None:
                continue
            if rel in seen:
                raise InputError(f"duplicate path in archive: {rel[:80]}")
            seen.add(rel)
            parts = rel.split("/")
            for i in range(1, len(parts)):
                if "/".join(parts[:i]) in links:
                    raise InputError(f"archive writes through a symlink: {rel[:80]}")
            target = os.path.join(dest, rel)
            parent = os.path.dirname(target)
            if member.isdir():
                _makedirs(dest, target)
                continue
            _makedirs(dest, parent)
            if member.issym():
                link = member.linkname
                resolved = os.path.normpath(os.path.join(os.path.dirname(rel), link))
                if (os.path.isabs(link) or resolved == ".." or resolved.startswith("../")
                        or "\x00" in link):
                    raise InputError(f"archive link points outside: {rel[:80]}")
                os.symlink(link, target)
                links.add(rel)
                continue
            if not member.isreg():
                raise InputError(f"unsupported archive entry type: {rel[:80]}")
            total += member.size
            if total > max_bytes:
                raise InputError("archive is too large")
            mode = 0o755 if member.mode & 0o111 else 0o644
            fd = os.open(target, os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW, mode)
            src = tar.extractfile(member)
            with os.fdopen(fd, "wb") as out:
                shutil.copyfileobj(src, out, 1024 * 1024)
            os.chmod(target, mode)
    return count


