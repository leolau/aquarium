def app_csp(base_path, mode):
    """Content-Security-Policy of one instance: every source pinned to the app's own
    path on the shared origin. Mirrors appContentSecurityPolicy() in
    agent-home/src/lib/apps/headers.ts (FG-33 decision 4)."""
    base = "https://{host}" + base_path
    own = f"{base} {base}/"
    script = f"{own} 'unsafe-inline'"  # no eval: dev is a built release too, never `next dev`
    return "; ".join([
        f"default-src {own}", f"script-src {script}", f"style-src {own} 'unsafe-inline'",
        f"img-src {own} data: blob:", f"media-src {own} data: blob:", f"font-src {own} data:",
        f"connect-src {own}", f"worker-src {own}", f"manifest-src {own}", "frame-src 'none'",
        "child-src 'none'", "object-src 'none'", "base-uri 'none'", f"form-action {own}",
        "frame-ancestors 'none'",
    ])


#: agent-home's session cookie (agent-home/src/lib/auth/session.ts SESSION_COOKIE,
#: `__Host-agent_home_session`) and its still-read legacy name LEGACY_SESSION_COOKIE.
SESSION_COOKIE_RE = r"(^|;\s*)(__Host-)?agent_home_session=[^;]*"
SESSION_SET_COOKIE_RE = r"(?i)^\s*(__Host-)?agent_home_session=.*$"


class InputError(Exception):
    """Rejected caller input (exit 2)."""


class Refused(Exception):
    """Valid request refused by policy or capacity (exit 3)."""


class HelperError(Exception):
    """Internal failure (exit 1)."""


# ---------------------------------------------------------------------------
# Validation
# ---------------------------------------------------------------------------


def check_slug(slug):
    if not isinstance(slug, str) or not SLUG_RE.fullmatch(slug) or "--" in slug:
        raise InputError("invalid slug (starts with a-z; a-z, 0-9 and single dashes, at most 40 characters)")
    return slug


def check_mode(mode):
    if mode not in MODES:
        raise InputError("mode must be dev or prod")
    return mode


def split_instance(inst):
    """``<slug>-<mode>`` → (slug, mode); the mode is the last dash part."""
    if not isinstance(inst, str) or "-" not in inst:
        raise InputError("invalid instance")
    slug, mode = inst.rsplit("-", 1)
    return check_slug(slug), check_mode(mode)


def spec_keys(spec, allowed, required=("slug", "mode")):
    if not isinstance(spec, dict):
        raise InputError("the request must be a JSON object")
    extra = set(spec) - set(allowed) - set(required)
    if extra:
        raise InputError(f"unknown field(s): {', '.join(sorted(extra))}")
    for key in required:
        if key not in spec:
            raise InputError(f"{key} is required")
    if "slug" in required:
        check_slug(spec["slug"])
    if "mode" in required:
        check_mode(spec["mode"])
    return spec


def check_approval(spec):
    """Prod activation must cite the promotion's approval/change reference."""
    ref = spec.get("approval_ref")
    if spec["mode"] == "prod":
        if not isinstance(ref, str) or not REF_RE.fullmatch(ref):
            raise InputError("prod needs an approval_ref (the promotion's approval)")
    elif ref is not None and (not isinstance(ref, str) or not REF_RE.fullmatch(ref)):
        raise InputError("invalid approval_ref")
    return ref


def check_secret_name(name):
    if not isinstance(name, str) or not NAME_RE.fullmatch(name):
        raise InputError("secret names look like MY_API_KEY (A-Z, 0-9, _)")
    if name in MANAGED_SECRET_NAMES:
        return name
    if name in RESERVED_SECRET_NAMES or name.startswith(RESERVED_SECRET_PREFIXES):
        raise InputError(f"{name} is reserved")
    return name


def read_spec(stream=None):
    stream = sys.stdin if stream is None else stream
    raw = stream.read(MAX_SPEC_BYTES + 1)
    if len(raw) > MAX_SPEC_BYTES:
        raise InputError("request is too large")
    if not raw.strip():
        return {}
    try:
        return json.loads(raw)
    except ValueError:
        raise InputError("the request is not valid JSON") from None


