def _root_file_ok(path):
    st = os.lstat(path)
    return (stat.S_ISREG(st.st_mode) and st.st_uid in TRUSTED_UIDS
            and not st.st_mode & (stat.S_IWGRP | stat.S_IWOTH))


def load_conf():
    conf = dict(DEFAULTS)
    if os.path.lexists(CONF_PATH):
        if not _root_file_ok(CONF_PATH):
            raise HelperError(f"{CONF_PATH} must be a root-owned file nobody else can write")
        try:
            with open(CONF_PATH, encoding="utf-8") as fh:
                data = json.load(fh)
        except (OSError, ValueError) as exc:
            raise HelperError(f"cannot read {CONF_PATH}: {exc}") from None
        if isinstance(data, dict):
            conf.update({k: v for k, v in data.items() if k in DEFAULTS})
    check_base(conf["storage_base"])
    if not isinstance(conf["tools_root"], str) or not os.path.isabs(conf["tools_root"]):
        raise HelperError("tools_root must be an absolute path")
    if not isinstance(conf["agent_home"], str) or not HOSTPORT_RE.fullmatch(conf["agent_home"]):
        raise HelperError("agent_home must be 127.0.0.1:<port>")
    if not re.fullmatch(r"[a-z_][a-z0-9_-]{0,31}", str(conf["tools_user"])):
        raise HelperError("invalid tools_user")
    conf["min_free_mb"] = int(conf["min_free_mb"])
    return conf


def check_base(base):
    if not isinstance(base, str) or not os.path.isabs(base) or os.path.normpath(base) != base:
        raise InputError("storage_base must be a normalised absolute path")
    if base == "/" or any(base == f or base.startswith(f + "/") for f in FORBIDDEN_BASES):
        raise InputError(f"storage_base may not be under {', '.join(FORBIDDEN_BASES)}")
    if len(base) > 200 or not re.fullmatch(r"[A-Za-z0-9/._-]+", base):
        raise InputError("storage_base has unsupported characters")
    return base


def trusted_dir(path, mode=0o755):
    """Create ``path`` (root, ``mode``) refusing symlinks and untrusted owners on the way."""
    parts = os.path.normpath(path).split("/")[1:]
    cur = "/"
    for part in parts:
        cur = os.path.join(cur, part)
        try:
            st = os.lstat(cur)
        except FileNotFoundError:
            os.mkdir(cur, mode)
            os.chmod(cur, mode)
            st = os.lstat(cur)
        if stat.S_ISLNK(st.st_mode) or not stat.S_ISDIR(st.st_mode):
            raise HelperError(f"{cur} is not a plain directory")
        if st.st_uid not in TRUSTED_UIDS or st.st_mode & stat.S_IWOTH and not st.st_mode & stat.S_ISVTX:
            raise HelperError(f"{cur} is not owned by root or is writable by others")
    return path


def inst_name(slug, mode):
    return f"{slug}-{mode}"


def dynamic_user(prefix, inst):
    """Per-instance DynamicUser name (decision 5). Without it systemd names
    every instance of a template after the template prefix, so all apps
    would share one uid. Hashed to stay within the 31-character limit."""
    return f"{prefix}-{hashlib.sha256(inst.encode()).hexdigest()[:16]}"


def paths(conf, slug, mode):
    inst = inst_name(slug, mode)
    app_dir = os.path.join(conf["storage_base"], slug)
    return {
        "inst": inst,
        "unit": UNIT_TEMPLATE.format(inst=inst),
        "build_unit": BUILD_TEMPLATE.format(inst=inst),
        "idle_unit": IDLE_UNIT.format(inst=inst),
        "app_dir": app_dir,
        "releases": os.path.join(app_dir, "releases"),
        "current": os.path.join(app_dir, mode),
        "stage": os.path.join(conf["storage_base"], ".stage", inst),
        "etc": os.path.join(ETC_APPS, slug),
        "env": os.path.join(ETC_APPS, slug, f"{mode}.env"),
        "creds": os.path.join(ETC_APPS, slug, mode),
        "dropin_dir": os.path.join(UNIT_DIR, UNIT_TEMPLATE.format(inst=inst) + ".d"),
        "dropin": os.path.join(UNIT_DIR, UNIT_TEMPLATE.format(inst=inst) + ".d", "10-instance.conf"),
        "build_dropin_dir": os.path.join(RUN_UNIT_DIR, BUILD_TEMPLATE.format(inst=inst) + ".d"),
        "caddy": os.path.join(CADDY_DIR, f"aquarium-{inst}.caddy"),
        "dsn": {cred: os.path.join(ETC_APPS, slug, f"db-{mode}-{kind}.dsn") for cred, kind in DSN_CREDENTIALS},
        "ticket_key": os.path.join(ETC_APPS, slug, f"ticket-{mode}.key"),
        "base_path": BASE_PATHS[mode].format(slug=slug),
        "idle_state": os.path.join(RUN_DIR, f"{inst}.idle.json"),
    }


# ---------------------------------------------------------------------------
# Small system helpers
# ---------------------------------------------------------------------------


def bin_path(name):
    for d in SAFE_PATH.split(":"):
        p = os.path.join(d, name)
        if os.path.isfile(p) and os.access(p, os.X_OK):
            return p
    raise HelperError(f"{name} is not installed")


def run(cmd, timeout=60, **kw):
    kw.setdefault("capture_output", True)
    kw.setdefault("text", True)
    try:
        return subprocess.run(cmd, timeout=timeout, env={"PATH": SAFE_PATH, "LC_ALL": "C"}, **kw)
    except subprocess.TimeoutExpired:
        raise HelperError(f"{os.path.basename(cmd[0])} timed out") from None


def systemctl(*args, timeout=60, check=True):
    proc = run([bin_path("systemctl"), *args], timeout=timeout)
    if check and proc.returncode != 0:
        raise HelperError(f"systemctl {' '.join(args)} failed: {(proc.stderr or '').strip()[:200]}")
    return proc


def show(unit, *props):
    proc = systemctl("show", unit, *[f"--property={p}" for p in props], check=False)
    out = {}
    for line in (proc.stdout or "").splitlines():
        key, _, value = line.partition("=")
        out[key] = value
    return out


def write_atomic(path, data, mode=0o600):
    tmp = f"{path}.tmp-{os.getpid()}"
    fd = os.open(tmp, os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW, mode)
    try:
        with os.fdopen(fd, "wb" if isinstance(data, bytes) else "w") as fh:
            fh.write(data)
        os.chmod(tmp, mode)
        os.replace(tmp, path)
    except BaseException:
        with contextlib.suppress(OSError):
            os.unlink(tmp)
        raise


def remove_path(path):
    if os.path.islink(path) or os.path.isfile(path):
        os.unlink(path)
    elif os.path.isdir(path):
        shutil.rmtree(path)


@contextlib.contextmanager
def flock(name, blocking=True):
    trusted_dir(RUN_DIR, 0o700)
    fd = os.open(os.path.join(RUN_DIR, name), os.O_RDWR | os.O_CREAT | os.O_NOFOLLOW, 0o600)
    try:
        try:
            fcntl.flock(fd, fcntl.LOCK_EX | (0 if blocking else fcntl.LOCK_NB))
        except BlockingIOError:
            yield False
            return
        yield True
    finally:
        os.close(fd)


def read_env(path):
    env = {}
    try:
        with open(path, encoding="utf-8") as fh:
            for line in fh:
                key, sep, value = line.strip().partition("=")
                if sep and NAME_RE.fullmatch(key):
                    env[key] = value
    except FileNotFoundError:
        pass
    return env


def current_release(p):
    """Name of the release <mode> points at, or None."""
    try:
        target = os.readlink(p["current"])
    except OSError:
        return None
    name = target[len("releases/"):] if target.startswith("releases/") else None
    if not name or "/" in name or not os.path.isdir(os.path.join(p["releases"], name)):
        return None
    return name


# ---------------------------------------------------------------------------
# Admission (re-check of FG-33 §6 box-wide limits; per-member limits are app_quota's)
# ---------------------------------------------------------------------------


def reserved_bytes():
    """``box.reserved_mb`` from the root-owned quota policy, else 3 GB."""
    mb = DEFAULT_RESERVED_MB
    try:
        if _root_file_ok(QUOTA_PATH):
            with open(QUOTA_PATH, encoding="utf-8") as fh:
                in_box = False
                for line in fh:
                    if re.match(r"^box:\s*(#.*)?$", line):
                        in_box = True
                    elif re.match(r"^\S", line):
                        in_box = False
                    elif in_box:
                        m = re.match(r"^\s+reserved_mb:\s*([0-9]{1,7})\s*(#.*)?$", line)
                        if m:
                            mb = int(m.group(1))
    except OSError:
        pass
    return mb * 1024 ** 2


def mem_available():
    with open(PROC_MEMINFO, encoding="ascii") as fh:
        for line in fh:
            if line.startswith("MemAvailable:"):
                return int(line.split()[1]) * 1024
    raise HelperError("MemAvailable missing from /proc/meminfo")


def slice_memory():
    value = show("aquarium.slice", "MemoryCurrent").get("MemoryCurrent", "")
    return int(value) if value.isdigit() else 0


def admit(request, what):
    current = slice_memory()
    if current + request > SLICE_CEILING:
        raise Refused(f"cannot {what}: local apps would use more than the 6 GB aquarium.slice "
                      f"ceiling ({current // 2**20} MB in use)")
    available = mem_available()
    if available - request < reserved_bytes():
        raise Refused(f"cannot {what}: the box would drop below its {reserved_bytes() // 2**20} MB "
                      f"memory reserve ({available // 2**20} MB available)")


def free_bytes(path):
    st = os.statvfs(path)
    return st.f_bavail * st.f_frsize


def admit_disk(conf, what):
    free = free_bytes(conf["storage_base"])
    if free < conf["min_free_mb"] * 1024 ** 2:
        raise Refused(f"cannot {what}: only {free // 2**20} MB free at {conf['storage_base']} "
                      f"(needs {conf['min_free_mb']} MB)")


# ---------------------------------------------------------------------------
# Ports and env files
# ---------------------------------------------------------------------------


def claimed_ports():
    ports = {}
    if not os.path.isdir(ETC_APPS):
        return ports
    for slug in sorted(os.listdir(ETC_APPS)):
        if not SLUG_RE.fullmatch(slug):
            continue
        for mode in MODES:
            port = read_env(os.path.join(ETC_APPS, slug, f"{mode}.env")).get("PORT", "")
            if port.isdigit():
                ports[int(port)] = inst_name(slug, mode)
    return ports


def port_free(port):
    with socket.socket(socket.AF_INET, socket.SOCK_STREAM) as s:
        try:
            s.bind(("127.0.0.1", port))
        except OSError:
            return False
    return True


def pick_port(mode, claimed):
    low, high = PORT_RANGES[mode]
    for port in range(low, high + 1):
        if port not in claimed and port_free(port):
            return port
    raise Refused(f"no free {mode} port left in {low}-{high}")


def env_text(slug, mode, port, base_path):
    return (f"# Written by aquarium-app-helper; do not edit.\nPORT={port}\nHOSTNAME=127.0.0.1\n"
            f"APP_SLUG={slug}\nAPP_MODE={mode}\nAPP_BASE_PATH={base_path}\n")


def ensure_allocated(conf, slug, mode):
    p = paths(conf, slug, mode)
    env = read_env(p["env"])
    port = env.get("PORT", "")
    if port.isdigit() and PORT_RANGES[mode][0] <= int(port) <= PORT_RANGES[mode][1]:
        return p, int(port)
    trusted_dir(ETC_APPS, 0o700)
    trusted_dir(p["etc"], 0o700)
    port = pick_port(mode, claimed_ports())
    write_atomic(p["env"], env_text(slug, mode, port, p["base_path"]), 0o600)
    return p, port


def require_allocated(conf, slug, mode):
    p = paths(conf, slug, mode)
    port = read_env(p["env"]).get("PORT", "")
    if not port.isdigit():
        raise InputError(f"{inst_name(slug, mode)} has no port yet (allocate first)")
    return p, int(port)


def secret_names(p):
    try:
        names = os.listdir(p["creds"])
    except FileNotFoundError:
        return []
    return sorted(n for n in names if NAME_RE.fullmatch(n) and os.path.isfile(os.path.join(p["creds"], n)))


