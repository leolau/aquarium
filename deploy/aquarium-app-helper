def status_doc(conf, slug, mode):
    p = paths(conf, slug, mode)
    env = read_env(p["env"])
    props = show(p["unit"], "ActiveState", "SubState", "UnitFileState", "MemoryCurrent",
                 "NRestarts", "ActiveEnterTimestamp")
    mem = props.get("MemoryCurrent", "")
    return {
        "slug": slug, "mode": mode, "unit": p["unit"],
        "port": int(env["PORT"]) if env.get("PORT", "").isdigit() else None,
        "base_path": p["base_path"],
        "release": current_release(p),
        "active_state": props.get("ActiveState") or "inactive",
        "sub_state": props.get("SubState") or "dead",
        "enabled": props.get("UnitFileState") == "enabled",
        "memory_bytes": int(mem) if mem.isdigit() else None,
        "restarts": int(props["NRestarts"]) if props.get("NRestarts", "").isdigit() else 0,
        "active_since": props.get("ActiveEnterTimestamp") if props.get("ActiveEnterTimestamp") not in ("", "n/a") else None,
        "routed": os.path.isfile(p["caddy"]),
        "secret_names": secret_names(p),
    }


def all_instances():
    out = []
    if os.path.isdir(ETC_APPS):
        for slug in sorted(os.listdir(ETC_APPS)):
            if SLUG_RE.fullmatch(slug):
                for mode in MODES:
                    if os.path.isfile(os.path.join(ETC_APPS, slug, f"{mode}.env")):
                        out.append((slug, mode))
    return out


def cmd_allocate(conf, spec):
    spec_keys(spec, ())
    with flock("ports.lock"):
        _, port = ensure_allocated(conf, spec["slug"], spec["mode"])
    return status_doc(conf, spec["slug"], spec["mode"])


def prune_releases(p_dev, p_prod):
    keep = {current_release(p_dev), current_release(p_prod)} - {None}
    try:
        names = os.listdir(p_dev["releases"])
    except FileNotFoundError:
        return
    others = [n for n in names if n not in keep and not n.startswith(".")]
    others.sort(key=lambda n: os.lstat(os.path.join(p_dev["releases"], n)).st_mtime, reverse=True)
    for name in others[KEEP_RELEASES:]:
        remove_path(os.path.join(p_dev["releases"], name))


def stage_source(conf, slug, sha, dest):
    src = os.path.join(conf["tools_root"], slug)
    st = os.lstat(src) if os.path.lexists(src) else None
    if st is None or not stat.S_ISDIR(st.st_mode):
        raise InputError(f"no app source at {src}")
    # git runs as the tools user: the repo (and its config/attributes) is agent-writable.
    git = [bin_path("runuser"), "-u", conf["tools_user"], "--", bin_path("env"), "-i",
           f"PATH={SAFE_PATH}", "HOME=/nonexistent", "GIT_CONFIG_NOSYSTEM=1",
           "GIT_CONFIG_GLOBAL=/dev/null", bin_path("git"), "-c", f"safe.directory={src}",
           "-c", "core.fsmonitor=false", "-C", src]
    proc = run(git + ["cat-file", "-t", sha], timeout=30)
    if proc.returncode != 0 or proc.stdout.strip() != "commit":
        raise InputError(f"{sha} is not a commit in {slug}")
    with open(dest, "wb") as out:
        proc = subprocess.run(git + ["archive", "--format=tar", sha], stdout=out,
                              stderr=subprocess.PIPE, timeout=120,
                              env={"PATH": SAFE_PATH, "LC_ALL": "C"})
    if proc.returncode != 0:
        raise HelperError(f"git archive failed: {proc.stderr.decode(errors='replace')[:200]}")
    if os.path.getsize(dest) > MAX_SOURCE_BYTES:
        raise Refused("app source is larger than 256 MB")


def build_dropin(p, base_path):
    return ("# Written by aquarium-app-helper for one build; removed afterwards.\n[Service]\n"
            f"User={dynamic_user('aqbuild', p['inst'])}\n"
            f"StandardInput=file:{os.path.join(p['stage'], 'source.tar')}\n"
            f"StandardOutput=truncate:{os.path.join(p['stage'], 'release.tar')}\n"
            f"Environment=APP_BASE_PATH={base_path} APP_SLUG={p['inst'].rsplit('-', 1)[0]}"
            f" APP_MODE={p['inst'].rsplit('-', 1)[1]}\n")


def cmd_build(conf, spec):
    spec_keys(spec, ("sha", "approval_ref"), ("slug", "mode", "sha"))
    slug, mode, sha = spec["slug"], spec["mode"], spec["sha"]
    if not isinstance(sha, str) or not SHA_RE.fullmatch(sha):
        raise InputError("sha must be a full 40-character commit id")
    check_approval(spec)
    p = paths(conf, slug, mode)
    release = f"{mode}-{sha}"
    rel_dir = os.path.join(p["releases"], release)
    with flock(f"{slug}.lock"):
        trusted_dir(conf["storage_base"])
        trusted_dir(p["releases"])
        built = False
        if not os.path.isdir(rel_dir):
            admit_disk(conf, "build")
            with flock("build.lock", blocking=False) as got:
                if not got:
                    raise Refused("another build or live-edit session is running (one slot box-wide)")
                admit(BUILD_REQUEST, "build")
                _run_build(conf, p, slug, sha, rel_dir)
                built = True
        link_tmp = f"{p['current']}.new"
        with contextlib.suppress(FileNotFoundError):
            os.unlink(link_tmp)
        os.symlink(f"releases/{release}", link_tmp)
        os.replace(link_tmp, p["current"])
        prune_releases(paths(conf, slug, "dev"), paths(conf, slug, "prod"))
    doc = status_doc(conf, slug, mode)
    doc.update(built=built, approval_ref=spec.get("approval_ref"))
    return doc


def _run_build(conf, p, slug, sha, rel_dir):
    trusted_dir(os.path.dirname(p["stage"]), 0o700)
    remove_path(p["stage"])
    os.mkdir(p["stage"], 0o700)
    os.makedirs(p["build_dropin_dir"], mode=0o755, exist_ok=True)
    dropin = os.path.join(p["build_dropin_dir"], "10-stage.conf")
    tmp_rel = f"{rel_dir}.tmp"
    try:
        stage_source(conf, slug, sha, os.path.join(p["stage"], "source.tar"))
        write_atomic(dropin, build_dropin(p, p["base_path"]), 0o644)
        systemctl("daemon-reload")
        systemctl("reset-failed", p["build_unit"], check=False)
        proc = systemctl("start", p["build_unit"], timeout=BUILD_TIMEOUT, check=False)
        if proc.returncode != 0:
            raise HelperError(f"build failed; see `logs` with build=true ({p['build_unit']})")
        remove_path(tmp_rel)
        os.mkdir(tmp_rel, 0o755)
        os.chmod(tmp_rel, 0o755)
        with open(os.path.join(p["stage"], "release.tar"), "rb") as fh:
            safe_extract(fh, tmp_rel, MAX_RELEASE_BYTES)
        if not os.path.isfile(os.path.join(tmp_rel, "server.js")):
            raise HelperError("the build produced no server.js (output: 'standalone' missing?)")
        _makedirs(tmp_rel, os.path.join(tmp_rel, ".next", "cache"))
        os.replace(tmp_rel, rel_dir)
    finally:
        remove_path(tmp_rel)
        remove_path(p["stage"])
        with contextlib.suppress(FileNotFoundError):
            os.unlink(dropin)
        with contextlib.suppress(OSError):
            os.rmdir(p["build_dropin_dir"])
        with contextlib.suppress(HelperError):
            systemctl("daemon-reload", check=False)


def _start(conf, slug, mode, restart=False):
    p, _ = require_allocated(conf, slug, mode)
    was_active = show(p["unit"], "ActiveState").get("ActiveState") == "active"
    if not was_active:
        admit(START_REQUEST, "start")
    write_instance_dropin(conf, p)
    systemctl("daemon-reload")
    systemctl("reset-failed", p["unit"], check=False)
    if mode == "prod":
        systemctl("enable", "--quiet", p["unit"])
    systemctl("restart" if (restart or was_active) else "start", p["unit"], timeout=90)
    if mode == "dev":
        start_idle_timer(p)
    return status_doc(conf, slug, mode)


def start_idle_timer(p):
    trusted_dir(RUN_DIR, 0o700)
    write_atomic(p["idle_state"], json.dumps({"last_activity": time.time()}), 0o600)
    if show(f"{p['idle_unit']}.timer", "ActiveState").get("ActiveState") == "active":
        return
    run([bin_path("systemd-run"), f"--unit={p['idle_unit']}", "--collect", "--quiet",
         f"--on-active={IDLE_CHECK_SECONDS}", f"--on-unit-active={IDLE_CHECK_SECONDS}",
         "--timer-property=AccuracySec=10s", "--", SELF_PATH, "idle-check", p["inst"]])


def cmd_start(conf, spec):
    spec_keys(spec, ())
    with flock(f"{spec['slug']}.lock"):
        return _start(conf, spec["slug"], spec["mode"])


def cmd_restart(conf, spec):
    spec_keys(spec, ())
    with flock(f"{spec['slug']}.lock"):
        return _start(conf, spec["slug"], spec["mode"], restart=True)


def _stop(conf, slug, mode):
    p = paths(conf, slug, mode)
    systemctl("stop", p["unit"], timeout=60, check=False)
    if mode == "prod":
        systemctl("disable", "--quiet", p["unit"], check=False)
    systemctl("stop", f"{p['idle_unit']}.timer", check=False)
    return p


def cmd_stop(conf, spec):
    spec_keys(spec, ())
    with flock(f"{spec['slug']}.lock"):
        _stop(conf, spec["slug"], spec["mode"])
        return status_doc(conf, spec["slug"], spec["mode"])


def caddy_block(conf, slug, mode, port):
    """One instance's include. Shape and headers follow the front-door contract in
    agent-home/deploy/Caddyfile.agent-home (FG-33 P8-1 1.5): route{} so the steps run
    in order, X-Aquarium-App names the instance to /api/apps/auth, the agent-home
    session cookie never reaches the app and the app can never set it."""
    p = paths(conf, slug, mode)
    bp = p["base_path"]
    matcher = f"@aquarium-app-{p['inst']}"
    return (
        f"# Written by aquarium-app-helper (FG-33) for {p['inst']}; do not edit.\n"
        f"{matcher} path {bp} {bp}/*\n"
        f"handle {matcher} {{\n"
        "\troute {\n"
        "\t\trequest_header -X-Aquarium-Principal\n"
        f"\t\tforward_auth {conf['agent_home']} {{\n"
        f"\t\t\turi /api/apps/auth?slug={slug}&mode={mode}\n"
        f"\t\t\theader_up X-Aquarium-App \"{slug}/{mode}\"\n"
        "\t\t\tcopy_headers X-Aquarium-Principal\n"
        "\t\t}\n"
        f"\t\trequest_header Cookie \"{SESSION_COOKIE_RE}\" \"\"\n"
        "\t\theader {\n"
        f"\t\t\tContent-Security-Policy \"{app_csp(bp, mode)}\"\n"
        "\t\t\tCross-Origin-Opener-Policy \"noopener-allow-popups\"\n"
        "\t\t\tX-Frame-Options \"DENY\"\n"
        "\t\t\tX-Content-Type-Options \"nosniff\"\n"
        "\t\t\tReferrer-Policy \"strict-origin-when-cross-origin\"\n"
        f"\t\t\tSet-Cookie \"{SESSION_SET_COOKIE_RE}\" \"agent_home_session_refused=; Max-Age=0\"\n"
        "\t\t\t-Service-Worker-Allowed\n"
        "\t\t\t-Clear-Site-Data\n"
        "\t\t\t-Server\n"
        "\t\t\tdefer\n"
        "\t\t}\n"
        f"\t\treverse_proxy 127.0.0.1:{port}\n"
        "\t}\n"
        "}\n"
    )


def check_caddy_block(text, conf):
    """Refuse any include that would expose an app without the agent-home login."""
    if not re.search(rf"^\t\tforward_auth {re.escape(conf['agent_home'])} \{{$", text, re.M):
        raise HelperError("refusing a Caddy block without forward_auth to agent-home")
    if not re.search(r"^\t\t\turi /api/apps/auth\?", text, re.M):
        raise HelperError("refusing a Caddy block whose forward_auth is not /api/apps/auth")
    if not re.search(r'^\t\t\theader_up X-Aquarium-App "[a-z0-9-]+/(dev|prod)"$', text, re.M):
        raise HelperError("refusing a Caddy block that does not name its instance to /api/apps/auth")
    if f'request_header Cookie "{SESSION_COOKIE_RE}" ""' not in text:
        raise HelperError("refusing a Caddy block that forwards the agent-home session cookie")
    if text.count("reverse_proxy") != 1 or text.index("forward_auth") > text.index("reverse_proxy"):
        raise HelperError("refusing a Caddy block that proxies before forward_auth")
    return text


def caddy_apply(path, new_text):
    """Write (or with None remove) one include, validate, reload; roll back on failure."""
    old = None
    if os.path.isfile(path):
        with open(path, encoding="utf-8") as fh:
            old = fh.read()
    if new_text is None:
        with contextlib.suppress(FileNotFoundError):
            os.unlink(path)
    else:
        trusted_dir(CADDY_DIR, 0o755)
        write_atomic(path, new_text, 0o644)
    if not os.path.isfile(CADDYFILE):
        return {"front_door": "no Caddyfile on this box"}
    proc = run([bin_path("caddy"), "validate", "--config", CADDYFILE, "--adapter", "caddyfile"],
               timeout=60)
    if proc.returncode != 0:
        if old is None:
            with contextlib.suppress(FileNotFoundError):
                os.unlink(path)
        else:
            write_atomic(path, old, 0o644)
        raise HelperError(f"caddy validate failed: {(proc.stderr or proc.stdout or '').strip()[-300:]}")
    systemctl("reload", "caddy", check=False)
    with open(CADDYFILE, encoding="utf-8") as fh:
        imported = any(line.strip() == CADDY_IMPORT for line in fh)
    return {"front_door": "ok" if imported else f"Caddyfile lacks `{CADDY_IMPORT}`"}


def cmd_route(conf, spec):
    spec_keys(spec, ())
    slug, mode = spec["slug"], spec["mode"]
    with flock(f"{slug}.lock"):
        p, port = require_allocated(conf, slug, mode)
        text = check_caddy_block(caddy_block(conf, slug, mode, port), conf)
        extra = caddy_apply(p["caddy"], text)
    doc = status_doc(conf, slug, mode)
    doc.update(extra)
    return doc


def cmd_unroute(conf, spec):
    spec_keys(spec, ())
    with flock(f"{spec['slug']}.lock"):
        p = paths(conf, spec["slug"], spec["mode"])
        extra = caddy_apply(p["caddy"], None) if os.path.isfile(p["caddy"]) else {}
    doc = status_doc(conf, spec["slug"], spec["mode"])
    doc.update(extra)
    return doc


def cmd_set_secret(conf, spec):
    spec_keys(spec, ("name", "value", "delete"), ("slug", "mode", "name"))
    name = check_secret_name(spec["name"])
    with flock(f"{spec['slug']}.lock"):
        p, _ = require_allocated(conf, spec["slug"], spec["mode"])
        target = os.path.join(p["creds"], name)
        if spec.get("delete") is True:
            if "value" in spec:
                raise InputError("give either value or delete, not both")
            with contextlib.suppress(FileNotFoundError):
                os.unlink(target)
        else:
            value = spec.get("value")
            if not isinstance(value, str) or not value or "\x00" in value:
                raise InputError("value must be a non-empty string")
            if len(value.encode()) > MAX_SECRET_BYTES:
                raise InputError("value is too large (8 KB max)")
            trusted_dir(p["etc"], 0o700)
            trusted_dir(p["creds"], 0o700)
            if name not in secret_names(p) and len(secret_names(p)) >= MAX_SECRETS:
                raise Refused(f"at most {MAX_SECRETS} secrets per app and mode")
            write_atomic(target, value, 0o600)
        running = show(p["unit"], "ActiveState").get("ActiveState") == "active"
        return {"slug": spec["slug"], "mode": spec["mode"], "secret_names": secret_names(p),
                "restart_needed": running}


def cmd_logs(conf, spec):
    spec_keys(spec, ("lines", "build"))
    lines = spec.get("lines", 200)
    if not isinstance(lines, int) or isinstance(lines, bool) or not 1 <= lines <= MAX_LOG_LINES:
        raise InputError(f"lines must be 1-{MAX_LOG_LINES}")
    p = paths(conf, spec["slug"], spec["mode"])
    unit = p["build_unit"] if spec.get("build") is True else p["unit"]
    proc = run([bin_path("journalctl"), "-u", unit, "-n", str(lines), "--no-pager",
                "-o", "short-iso", "-q"], timeout=30)
    text = proc.stdout or ""
    truncated = len(text.encode()) > MAX_LOG_BYTES
    if truncated:
        text = text.encode()[-MAX_LOG_BYTES:].decode(errors="replace")
    return {"slug": spec["slug"], "mode": spec["mode"], "unit": unit, "lines": text,
            "truncated": truncated}


def cmd_status(conf, spec):
    if isinstance(spec, dict) and spec.get("all") is True:
        if set(spec) != {"all"}:
            raise InputError("status with all takes no other field")
        docs = [status_doc(conf, s, m) for s, m in all_instances()]
        problems = [f"{d['unit']} is {d['active_state']} ({d['sub_state']})"
                    for d in docs if d["enabled"] and d["active_state"] != "active"]
        return {"instances": docs, "problems": problems}
    spec_keys(spec, ())
    return status_doc(conf, spec["slug"], spec["mode"])


def cmd_remove(conf, spec):
    spec_keys(spec, ("confirm",))
    slug, mode = spec["slug"], spec["mode"]
    if spec.get("confirm") != slug:
        raise Refused(f"removing {inst_name(slug, mode)} deletes its releases and secrets; "
                      f"repeat the slug as confirm to go ahead")
    with flock(f"{slug}.lock"):
        p = _stop(conf, slug, mode)
        if os.path.isfile(p["caddy"]):
            with contextlib.suppress(HelperError):
                caddy_apply(p["caddy"], None)
        remove_path(p["dropin_dir"])
        systemctl("daemon-reload", check=False)
        systemctl("clean", "--what=cache", p["unit"], check=False)
        for key in ("env", "creds", "current", "idle_state"):
            remove_path(p[key])
        other = paths(conf, slug, "prod" if mode == "dev" else "dev")
        if os.path.isfile(other["env"]) or os.path.lexists(other["current"]):
            prune_releases(paths(conf, slug, "dev"), paths(conf, slug, "prod"))
        else:
            remove_path(p["app_dir"])
            with contextlib.suppress(OSError):
                os.rmdir(p["etc"])
    return {"slug": slug, "mode": mode, "removed": True}


def _whole(value, what):
    if not isinstance(value, int) or isinstance(value, bool) or not 0 <= value <= MAX_LIMIT:
        raise InputError(f"{what} must be a whole number from 0 to {MAX_LIMIT}")
    return value


def check_limits(limits):
    """``{"member"|"admin": {"per_app": {..}, "per_member": {..}} | None}``."""
    if not isinstance(limits, dict) or not limits:
        raise InputError("limits must be a non-empty object")
    clean = {}
    for tier, sections in limits.items():
        if tier not in LIMIT_TIERS:
            raise InputError(f"unknown limits tier {tier!r}")
        if sections is None:
            clean[tier] = None
            continue
        if not isinstance(sections, dict):
            raise InputError(f"limits.{tier} must be an object or null")
        out = {}
        for section, values in sections.items():
            if section not in LIMIT_KEYS or not isinstance(values, dict):
                raise InputError(f"unknown limits section {tier}.{section}")
            for key, value in values.items():
                if key not in LIMIT_KEYS[section]:
                    raise InputError(f"unknown limit {tier}.{section}.{key}")
                out.setdefault(section, {})[key] = _whole(value, f"{tier}.{section}.{key}")
        clean[tier] = out
    return clean


def read_limits():
    if not os.path.lexists(_etc(LIMITS_PATH)):
        return {}
    if not _root_file_ok(_etc(LIMITS_PATH)):
        raise HelperError(f"{_etc(LIMITS_PATH)} must be a root-owned file nobody else can write")
    with open(_etc(LIMITS_PATH), encoding="utf-8") as fh:
        data = json.load(fh)
    roles = data.get("roles") if isinstance(data, dict) else None
    return roles if isinstance(roles, dict) else {}


def _read_json_conf():
    if not os.path.isfile(CONF_PATH):
        return {}
    with open(CONF_PATH, encoding="utf-8") as fh:
        data = json.load(fh)
    return data if isinstance(data, dict) else {}


def set_apps_base(base):
    """Point deploy/aquarium.py's APPS_BASE at ``base``, keeping every other line."""
    lines = []
    mode = 0o644
    if os.path.lexists(_etc(AQUARIUM_CONF)):
        if not _root_file_ok(_etc(AQUARIUM_CONF)):
            raise HelperError(f"{_etc(AQUARIUM_CONF)} must be a root-owned file nobody else can write")
        mode = stat.S_IMODE(os.lstat(_etc(AQUARIUM_CONF)).st_mode)
        with open(_etc(AQUARIUM_CONF), encoding="utf-8") as fh:
            lines = fh.read().splitlines()
    pattern = re.compile(r"^\s*(?:export\s+)?APPS_BASE\s*=")
    kept = [ln for ln in lines if not pattern.match(ln)]
    kept.append(f"APPS_BASE={base}")
    trusted_dir(os.path.dirname(_etc(AQUARIUM_CONF)), 0o755)
    write_atomic(_etc(AQUARIUM_CONF), "\n".join(kept) + "\n", mode)


def cmd_configure(conf, spec):
    spec_keys(spec, ("storage_base", "min_free_mb", "limits"), ())
    data = None
    if "storage_base" in spec:
        base = check_base(spec["storage_base"])
        if base != conf["storage_base"]:
            old = conf["storage_base"]
            if os.path.isdir(old) and any(not n.startswith(".") for n in os.listdir(old)):
                raise Refused(f"apps already live under {old}; remove or move them first")
            trusted_dir(base)
            data = _read_json_conf()
            data["storage_base"] = base
        set_apps_base(base)
    if "min_free_mb" in spec:
        data = data if data is not None else _read_json_conf()
        data["min_free_mb"] = _whole(spec["min_free_mb"], "min_free_mb")
    if "limits" in spec:
        roles = dict(read_limits())
        for tier, sections in check_limits(spec["limits"]).items():
            if sections is None:
                roles.pop(tier, None)
            else:
                roles[tier] = sections
        trusted_dir(os.path.dirname(_etc(LIMITS_PATH)), 0o755)
        write_atomic(_etc(LIMITS_PATH), json.dumps({"roles": roles}, indent=2, sort_keys=True) + "\n",
                     0o644)
    if data is not None:
        trusted_dir(os.path.dirname(CONF_PATH), 0o755)
        write_atomic(CONF_PATH, json.dumps(data, indent=2, sort_keys=True) + "\n", 0o644)
        conf = load_conf()
    base = conf["storage_base"]
    free = free_bytes(base) if os.path.isdir(base) else None
    return {"storage_base": base, "free_bytes": free, "min_free_mb": conf["min_free_mb"],
            "limits": read_limits()}


def _established(port):
    """Open TCP connections to 127.0.0.1:<port> (the Caddy proxy's)."""
    n = 0
    for path in PROC_NET_TCP:
        try:
            with open(path, encoding="ascii") as fh:
                next(fh, None)
                for line in fh:
                    cols = line.split()
                    if len(cols) > 3 and cols[3] == "01" and cols[1].rsplit(":", 1)[-1] == f"{port:04X}":
                        n += 1
        except OSError:
            continue
    return n


def cmd_idle_check(conf, inst):
    slug, mode = split_instance(inst)
    if mode != "dev":
        raise InputError("only dev instances idle-stop")
    p = paths(conf, slug, mode)
    with flock(f"{slug}.lock", blocking=False) as got:
        if not got:
            return {"slug": slug, "mode": mode, "idle": "busy"}
        if show(p["unit"], "ActiveState").get("ActiveState") != "active":
            systemctl("stop", f"{p['idle_unit']}.timer", check=False)
            return {"slug": slug, "mode": mode, "idle": "stopped"}
        port = read_env(p["env"]).get("PORT", "")
        try:
            with open(p["idle_state"], encoding="utf-8") as fh:
                last = float(json.load(fh).get("last_activity") or 0)
        except (OSError, ValueError, AttributeError):
            last = 0.0
        now = time.time()
        if port.isdigit() and _established(int(port)):
            last = now
        write_atomic(p["idle_state"], json.dumps({"last_activity": last}), 0o600)
        if now - last >= DEV_IDLE_SECONDS:
            _stop(conf, slug, mode)
            return {"slug": slug, "mode": mode, "idle": "stopped"}
        return {"slug": slug, "mode": mode, "idle": "active", "idle_seconds": int(now - last)}


