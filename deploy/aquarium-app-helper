def cmd_run_app():
    """ExecStart of aquarium-app@: credentials → environment, then node server.js."""
    env = dict(os.environ)
    creds = env.get("CREDENTIALS_DIRECTORY")
    if creds and os.path.isdir(creds):
        for name in sorted(os.listdir(creds)):
            if NAME_RE.fullmatch(name):
                with open(os.path.join(creds, name), encoding="utf-8") as fh:
                    env[name] = fh.read().rstrip("\r\n")
    os.execve(NODE, [NODE, "server.js"], env)


def cmd_build_run():
    """ExecStart of aquarium-app-build@: source tar on stdin, release tar on stdout."""
    cache = os.environ.get("CACHE_DIRECTORY")
    if not cache or not os.path.isdir(cache):
        raise HelperError("CACHE_DIRECTORY is not set (run only inside aquarium-app-build@)")
    work = os.path.join(cache, "work")
    remove_path(work)
    os.mkdir(work, 0o700)
    safe_extract(sys.stdin.buffer, work, MAX_SOURCE_BYTES)
    for required in ("package.json", "package-lock.json"):
        if not os.path.isfile(os.path.join(work, required)):
            raise InputError(f"the app has no {required} (a committed lockfile is required)")
    env = dict(os.environ, npm_config_cache=os.path.join(cache, "npm"))
    log = sys.stderr
    steps = [
        [NPM, "ci", "--ignore-scripts", "--no-audit", "--no-fund"],
        [NODE, os.path.join("node_modules", "next", "dist", "bin", "next"), "build"],
    ]
    for step in steps:
        proc = subprocess.run(step, cwd=work, env=env, stdout=log, stderr=log, timeout=BUILD_TIMEOUT)
        if proc.returncode != 0:
            raise HelperError(f"{os.path.basename(step[0])} {step[1] if step[0] == NPM else 'next build'} "
                              f"exited {proc.returncode}")
    standalone = os.path.join(work, ".next", "standalone")
    if not os.path.isfile(os.path.join(standalone, "server.js")):
        raise HelperError("next build produced no .next/standalone/server.js")
    with tarfile.open(fileobj=sys.stdout.buffer, mode="w|") as out:
        for name in sorted(os.listdir(standalone)):
            out.add(os.path.join(standalone, name), arcname=name)
        static = os.path.join(work, ".next", "static")
        if os.path.isdir(static) and not os.path.lexists(os.path.join(standalone, ".next", "static")):
            out.add(static, arcname=".next/static")
        public = os.path.join(work, "public")
        if os.path.isdir(public) and not os.path.lexists(os.path.join(standalone, "public")):
            out.add(public, arcname="public")
    return None


VERBS = {
    "allocate": cmd_allocate, "build": cmd_build, "start": cmd_start, "stop": cmd_stop,
    "restart": cmd_restart, "route": cmd_route, "unroute": cmd_unroute,
    "set-secret": cmd_set_secret, "logs": cmd_logs, "status": cmd_status,
    "remove": cmd_remove, "configure": cmd_configure,
}
USAGE = ("usage: aquarium-app-helper " + "|".join(VERBS) + " < request.json"
         " | status --all | idle-check <slug>-dev | run-app | build-run")


def main(argv=None, stdin=None):
    argv = list(sys.argv[1:] if argv is None else argv)
    # build-run's stdout is the release tarball: messages go to the journal.
    out = sys.stderr if argv == ["build-run"] else sys.stdout
    try:
        if argv in (["run-app"], ["build-run"]):
            if os.geteuid() == 0:
                raise HelperError(f"{argv[0]} runs only inside its unit, never as root")
            if argv[0] == "run-app":
                cmd_run_app()
            cmd_build_run()
            return 0
        os.environ["PATH"] = SAFE_PATH
        os.umask(0o077)
        if os.geteuid() != 0:
            raise HelperError("aquarium-app-helper must run as root (use sudo -n)")
        conf = load_conf()
        if len(argv) == 2 and argv[0] == "idle-check":
            doc = cmd_idle_check(conf, argv[1])
        elif argv == ["status", "--all"]:
            doc = cmd_status(conf, {"all": True})
        elif len(argv) == 1 and argv[0] in VERBS:
            doc = VERBS[argv[0]](conf, read_spec(stdin))
        else:
            raise InputError(USAGE)
    except InputError as exc:
        print(json.dumps({"error": str(exc), "bad_input": True}), file=out)
        return 2
    except Refused as exc:
        print(json.dumps({"error": str(exc), "refused": True}), file=out)
        return 3
    except (HelperError, OSError, tarfile.TarError) as exc:
        message = str(exc)
        if isinstance(exc, OSError):
            message = f"{exc.strerror or exc}" + (f": {exc.filename}" if exc.filename else "")
        print(json.dumps({"error": message[:300]}), file=out)
        return 1
    print(json.dumps(doc))
    return 0


if __name__ == "__main__":
    sys.exit(main())
