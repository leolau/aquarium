# Email account passwords (Gmail App Passwords)
EMAIL1_PASSWORD=xxxx-xxxx-xxxx-xxxx
EMAIL2_PASSWORD=xxxx-xxxx-xxxx-xxxx
EMAIL3_PASSWORD=xxxx-xxxx-xxxx-xxxx

# DeepSeek API key for triage agent
DEEPSEEK_API_KEY=sk-your-deepseek-api-key

# Telegram bot for escalations and merge confirmations
TELEGRAM_BOT_TOKEN=your-bot-token
TELEGRAM_ALLOWED_USERS=your-telegram-user-id
TELEGRAM_USER_ID=your-telegram-user-id

# Google Calendar OAuth2 (from Google Cloud Console)
GCAL_CLIENT_ID=your-client-id.apps.googleusercontent.com
GCAL_CLIENT_SECRET=your-client-secret

# Google Calendar refresh tokens (from calendar_auth.py flow)
GCAL_REFRESH_TOKEN_1=your-refresh-token-for-account-1
GCAL_REFRESH_TOKEN_2=your-refresh-token-for-account-2
GCAL_REFRESH_TOKEN_3=your-refresh-token-for-account-3

# Local custom services (security review F1). The MCP servers bind 127.0.0.1
# and refuse every tool call without "Authorization: Bearer <token>".
# Generate with: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
EMAIL_MCP_TOKEN=generate-a-random-token
WHATSAPP_MCP_TOKEN=generate-a-random-token
# Telegram merge/keep links are HMAC-signed (key derived from TELEGRAM_BOT_TOKEN
# unless CALLBACK_SIGNING_SECRET is set) and expire after 7 days. The callback
# server binds 127.0.0.1; publish it via an HTTPS reverse proxy and point
# CALLBACK_SERVER_BASE at it (or set CALLBACK_BIND_HOST=0.0.0.0 deliberately).
# CALLBACK_SERVER_BASE=https://your-host/contact-callback
# CALLBACK_SIGNING_SECRET=
# CALLBACK_BIND_HOST=127.0.0.1
