# agent-home environment (FG-20 Wave A).
#
# Policy (AGENTS.md + FG-20): NO new non-secret HERMES_* env vars. Real secrets
# live here in .env (like a Supabase key); deploy-topology values are namespaced
# AGENT_HOME_* so they never extend the Python HERMES_* namespace. Copy this to
# `agent-home/.env.local` for local dev; never commit real values.

# --- Secrets -----------------------------------------------------------------
# HMAC key that signs the agent-home session cookie. Generate a long random
# value, e.g.  openssl rand -hex 32
AGENT_HOME_SESSION_SECRET=

# Postgres DSN for server-side Supabase reads. Same connection string the
# Python backend uses for the Supabase app datastore (drives FORCE'd RLS).
DATABASE_URL=

# Supabase project URL + anon (browser-safe) key, for RLS-scoped Realtime.
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Server-side Supabase Storage key for uploading chat media (Wave C1). Used only
# in the agent-home BFF (never sent to the browser). Leave unset to disable the
# chat attach button — chat send still works without it.
SUPABASE_SERVICE_ROLE_KEY=

# HMAC secret shared with the app-mcp service to sign WebSocket tickets for the
# browser bridge. Must equal the app-mcp service's APP_MCP_TICKET_SECRET. Leave
# unset to keep the bridge disconnected (everything else still works).
AGENT_HOME_APP_MCP_SECRET=

# FG-33 local apps front door: master HMAC secret for the per-app
# X-Aquarium-Principal tickets /api/apps/auth mints (src/lib/apps/ticket.ts).
# The app helper derives each instance's key from it. Leave unset to keep
# /apps/* closed (forward_auth answers 503).
AGENT_HOME_APPS_TICKET_SECRET=

# --- Deploy topology (non-secret) --------------------------------------------
# Base URL of the Python AI layer (/api/*, /auth/*). On the prod box this is the
# on-box loopback that Caddy also fronts. Defaults to http://127.0.0.1:9119.
AGENT_HOME_API_URL=http://127.0.0.1:9119

# C3 datastore mode: dev -> app_dev schema, prod -> app_prod. Defaults to dev.
AGENT_HOME_DATASTORE_MODE=dev

# Supabase Storage bucket chat media is written to. Defaults to agent-home-media.
# The bucket MUST be private: reads go through /api/chat/media, which signs a
# short-lived URL only after verifying the caller owns the object prefix.
AGENT_HOME_MEDIA_BUCKET=agent-home-media

# TTL (seconds) of those signed media URLs. Defaults to 60, clamped to 5..3600.
AGENT_HOME_MEDIA_URL_TTL=60

# Loopback port `next start` binds (Caddy proxies to it). Defaults to 3100.
PORT=3100

# On-box deploy note: put these in `agent-home/agent-home.env` (read by systemd),
# NOT `.env.production` — Next auto-loads/expands `.env*` files and a DSN that
# resolves from ${DATABASE_URL} self-references and overflows the stack. See
# deploy/DEPLOY.md.
