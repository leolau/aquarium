# app-mcp service environment (0600, NOT committed).
#
# Shared HMAC secret — MUST equal AGENT_HOME_APP_MCP_SECRET in
# agent-home/agent-home.env. The BFF signs 60s WebSocket tickets with it;
# this service verifies them. Generate once:  openssl rand -hex 32
APP_MCP_TICKET_SECRET=

# Hermes home of the gateway/dashboard (the same HERMES_HOME they run with).
# app-mcp reads the MCP bearer token Hermes creates at
# $HERMES_HOME/auth/app-mcp-token (security review F19). Empty = the MCP
# endpoint 127.0.0.1:9220/mcp stays open to any local caller (old behaviour).
HERMES_HOME=

# Loopback ports (defaults shown; Caddy fronts only the WS one).
APP_MCP_PORT=9220
APP_MCP_WS_PORT=9221

# Seconds of silence to tolerate before reporting a command timeout back to
# the agent. The browser pings progress while a command is in flight, so
# this bounds inactivity — not total elapsed time; long-running commands
# (e.g. a multi-GB file import) survive as long as the tab keeps pinging.
APP_MCP_COMMAND_TIMEOUT=10

# Same idea for Folder Bridge (/app-mcp/folders/ws) commands. Higher default
# because a real directory search/read can legitimately take longer than a
# UI click. Set very high (3600) because a large file import (1+ GB) can take
# many minutes to upload; the browser's progress pings make this a silence
# deadline, not a total cap.
APP_MCP_FOLDER_COMMAND_TIMEOUT=3600

# Network folders (office file shares through a VPN, ids net-*): bearer token
# app-mcp presents to the Hermes dashboard's /api/internal/vpn/folders*
# routes. MUST equal APP_MCP_HERMES_TOKEN in the Hermes .env. >= 32 chars:
#   openssl rand -hex 32
# Leave empty to disable network folders in folder_bridge_*.
APP_MCP_HERMES_TOKEN=
# Dashboard address (default shown).
# APP_MCP_HERMES_URL=http://127.0.0.1:9119
