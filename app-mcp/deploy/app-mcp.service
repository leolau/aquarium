# systemd unit for app-mcp (agent-home UI introspection/control bridge, plus
# the Folder Bridge local-filesystem MCP tools).
#
# Two loopback listeners: the WebSocket hub the browser bridge connects to
# (127.0.0.1:9221 — Caddy fronts ONLY /app-mcp/ws and /app-mcp/folders/ws on
# the public origin), and the MCP streamable-HTTP endpoint the Hermes agent
# consumes (127.0.0.1:9220/mcp, via `mcp_servers: app:` in the agent's
# config.yaml).
#
# Runs from the main checkout (FG-23 A0.1 pattern): one `git pull` moves it.
# Reuses the hermes-agent venv — mcp and websockets are already pinned there.
#
# Install:
#   sudo cp app-mcp/deploy/app-mcp.service /etc/systemd/system/
#   sudo cp app-mcp/deploy/app-mcp.env.example /opt/data/hermes-agent/app-mcp/app-mcp.env
#   # fill APP_MCP_TICKET_SECRET (same value as AGENT_HOME_APP_MCP_SECRET in
#   # agent-home/agent-home.env) and HERMES_HOME (the gateway's Hermes home,
#   # where Hermes writes the MCP bearer token), then: sudo chmod 0600 that env file
#   sudo systemctl daemon-reload && sudo systemctl enable --now app-mcp.service

[Unit]
Description=app-mcp (agent-home UI introspection/control bridge for the agent)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=hermes
Group=hermes
WorkingDirectory=/opt/data/hermes-agent/app-mcp
# Secrets live in /etc/aquarium/app-mcp.env (root:root 0600; systemd reads it
# as root, so the hermes user and the agent's shell can't). The old in-checkout
# file is still read first so a box that hasn't moved it keeps working; the
# /etc one wins for any key in both (security review F16).
EnvironmentFile=-/opt/data/hermes-agent/app-mcp/app-mcp.env
EnvironmentFile=-/etc/aquarium/app-mcp.env
ExecStart=/opt/data/hermes-agent/.venv/bin/python -m app_mcp.server
Restart=on-failure
RestartSec=5
StandardOutput=journal
StandardError=journal

# Hardening — same stance as agent-home.service and the hermes-* units.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=yes

[Install]
WantedBy=multi-user.target
